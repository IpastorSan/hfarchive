# Copy to .env and source it, or just export these in your shell.

# Destination root — the external drive mount point, never a path in /home.
LOCAL_MODEL_BACKUP_DEST=/run/media/ignacio/BACKUP1

# Only needed for gated repos. Prefer `hf auth login`, which stores the token
# in ~/.cache/huggingface/ instead of a file in the project.
# HF_TOKEN=hf_...

# Faster transfers for large files (installed with: pip install hf_transfer)
# HF_HUB_ENABLE_HF_TRANSFER=1
