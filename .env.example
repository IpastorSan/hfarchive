# Copy to .env and source it, or export these in your shell.

# Destination root: the mount point of the drive to archive onto.
HFARCHIVE_DEST=/mnt/backup

# Path to an `hf` binary, only needed if the script's own environment has none.
# HFARCHIVE_HF_BIN=/usr/local/bin/hf

# Only needed for gated repos. Prefer `hf auth login`, which stores the token
# in ~/.cache/huggingface/ instead of a file.
# HF_TOKEN=hf_...
