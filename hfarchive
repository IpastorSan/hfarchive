#     ref: v0.45.0
#     # Python dependencies as wheels under _runtimes/<id>/wheels-<ref>/<platform>/,
#     # with an INSTALL.md for installing them offline. --no-wheels skips them.
#     wheels:
#       python: "3.12"                            # quoted
#       platforms: [manylinux_2_28_x86_64, win_amd64]
#       requirements: [requirements.txt]         # paths in the source at `ref`
#       packages: ["torch==2.14.1+cu130"]         # extra requirement lines
#       index_url: https://download.pytorch.org/whl/cu130
#       extra_index_urls: [https://pypi.org/simple]
#       start: Run `.venv/bin/python main.py` in the unpacked source.
"""


def repo_root() -> Path:
    """The script's own directory: the repo root when it runs from a clone."""
    return Path(__file__).resolve().parent


def repo_raw_urls(path: str) -> list[str]:
    """`path` in this repo on GitHub: at this version's tag, then on main."""
    return [REPO_RAW_URL.format(ref=ref, path=path) for ref in (f"v{__version__}", "main")]


def curated_in_clone() -> Path | None:
    """The curated selection, when the script runs from a clone of its repo."""
    path = repo_root() / "examples" / CURATED_CONFIG
    return path if path.is_file() else None


def fetch_text(url: str, timeout: float = 30) -> str:
    with http_open(url, timeout=timeout) as resp:
        return resp.read().decode("utf-8")


def curated_text() -> str:
    """The curated selection: from the clone, else from this version's tag, else main."""
    local = curated_in_clone()
    if local:
        return local.read_text()
    errors = []
    for url in repo_raw_urls("examples/" + CURATED_CONFIG):
        try:
            return fetch_text(url)
        except (urllib.error.URLError, OSError) as exc:
            errors.append(f"{url}: {exc}")
    raise CatalogError("could not fetch the curated selection: " + "; ".join(errors)
                       + ". Use --init --minimal for the small offline starter.")


def write_starter_config(path: Path, minimal: bool = False) -> int:
    if path.exists():
        print(f"error: {path} already exists; refusing to overwrite it", file=sys.stderr)
        return 2
    try:
        text = STARTER_CONFIG if minimal else curated_text()
    except CatalogError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    what = "the minimal starter" if minimal else f"the curated selection ({CURATED_CONFIG})"
    print(f"wrote {what} to {path}; edit it, then run: hfarchive --config {path} --list")
    return 0


def resolve_config(arg: str | None) -> tuple[Path, str | None]:
    """(config path, notice). Without --config: ./models.yaml, else the curated
    selection when running from a clone. A missing file is left to load_catalog."""
    if arg:
        return Path(arg).expanduser(), None
    default = Path(DEFAULT_CONFIG)
    if default.is_file():
        return default, None
    curated = curated_in_clone()
    if curated:
        return curated, f"no ./{DEFAULT_CONFIG}; using the curated selection {curated}"
    return default, None


# ====================================================================== hub
def token_available() -> bool:
    """True if an HF token is reachable (HF_TOKEN env or `hf auth login`).

    The token itself is never returned, logged or printed.
    """
    try:
        return bool(get_token())
    except Exception:
        return False


@dataclass
class RepoStatus:
    model: Model
    exists: bool = False
    gated: bool = False
    commit: str | None = None
    files: list[tuple[str, int]] = field(default_factory=list)
    total_repo_bytes: int = 0
    error: str | None = None
    # path -> {"sha256": ...} for LFS files, {"git_sha1": ...} for the rest
    hashes: dict[str, dict] = field(default_factory=dict)
    # model cards the include/exclude globs left out; fetched by name
    extra_cards: list[str] = field(default_factory=list)

    @property
    def matched_files(self) -> int:
        return len(self.files)

    @property
    def matched_bytes(self) -> int:
        return sum(size for _, size in self.files)

    def local_state(self, dest: Path) -> tuple[int, int]:
        """(bytes already present and complete, bytes still missing).

        A file counts as complete when it exists locally with the exact size
        the Hub reports, which is what `hf download` itself uses to skip work.
        """
        here = missing = 0
        root = self.model.dest_dir(dest)
        for rel, size in self.files:
            p = root / rel
            try:
                if p.is_file() and p.stat().st_size == size:
                    here += size
                    continue
            except OSError:
                pass
            missing += size
        return here, missing


def _match(model: Model, names: list[str]) -> list[str]:
    return list(
        filter_repo_objects(
            names,
            allow_patterns=model.include or None,
            ignore_patterns=model.exclude or None,
        )
    )


def is_model_card(name: str) -> bool:
    """README.md and LICENSE*/LICENCE* at the repo root: always archived."""
    if "/" in name:
        return False
    upper = name.upper()
    return name == "README.md" or upper.startswith("LICENSE") or upper.startswith("LICENCE")


def select_files(model: Model, names: list[str]) -> tuple[list[str], list[str]]:
    """(files the globs match, model cards they left out). Both are archived."""
    matched = _match(model, names)
    chosen = set(matched)
    return matched, [n for n in names if is_model_card(n) and n not in chosen]


def sibling_hash(sibling) -> dict:
    """The Hub's hash for one file: sha256 for LFS/Xet files, git blob sha1 otherwise."""
    lfs = getattr(sibling, "lfs", None)
    sha256 = lfs.get("sha256") if isinstance(lfs, dict) else getattr(lfs, "sha256", None)
    if sha256:
        return {"sha256": sha256}
    blob = getattr(sibling, "blob_id", None)
    return {"git_sha1": blob} if blob else {}


def probe(model: Model, api: HfApi | None = None) -> RepoStatus:
    """Resolve one repo against the Hub. Never raises."""
    api = api or HfApi()
    st = RepoStatus(model=model)
    try:
        info = api.model_info(model.hf_repo, revision=model.revision, files_metadata=True)
    except RepositoryNotFoundError:
        st.error = "repo not found (or private)"
        return st
    except GatedRepoError:
        # Metadata itself is gated: we know it exists but cannot size it.
        st.exists = True
        st.gated = True
        st.error = "gated: metadata requires an accepted licence + token"
        return st
    except EntryNotFoundError:
        st.error = f"revision not found: {model.revision}"
        return st
    except Exception as exc:  # network, rate limit, ...
        st.error = f"{type(exc).__name__}: {exc}"
        return st

    st.exists = True
    st.gated = bool(info.gated)
    st.commit = info.sha
    # files_metadata=True carries the same per-file lfs.sha256 and blob_id that
    # get_paths_info / list_repo_tree(expand=True) return, for this exact commit.
    sizes = {s.rfilename: (s.size or 0) for s in info.siblings}
    st.total_repo_bytes = sum(sizes.values())
    matched, st.extra_cards = select_files(model, list(sizes))
    names = matched + st.extra_cards
    st.files = [(n, sizes[n]) for n in names]
    hashes = {s.rfilename: sibling_hash(s) for s in info.siblings}
    st.hashes = {n: hashes[n] for n in names if hashes.get(n)}
    if not matched:
        st.error = "include/exclude globs matched no files"
    return st


def probe_all(models: list[Model], workers: int = 8) -> list[RepoStatus]:
    """Probe repos concurrently, preserving input order."""
    if not models:
        return []
    api = HfApi()
    with cf.ThreadPoolExecutor(max_workers=max(1, min(workers, len(models)))) as ex:
        return list(ex.map(lambda m: probe(m, api), models))


# ================================================================= download
def resolve_hf_bin() -> str | None:
    """Locate the `hf` CLI: this interpreter's environment, then $HFARCHIVE_HF_BIN, then PATH.

    The sibling of sys.executable comes first so the CLI matches the
    huggingface_hub version used to resolve metadata.
    """
    sibling = Path(sys.executable).parent / "hf"
    if sibling.exists():
        return str(sibling)
    explicit = os.environ.get(HF_BIN_ENV)
    if explicit:
        return explicit if Path(explicit).exists() else None
    return shutil.which("hf")


@dataclass
class DownloadResult:
    model: Model
    status: str  # downloaded | skipped-gated | failed | up-to-date
    bytes_expected: int = 0
    commit: str | None = None
    message: str = ""
    returncode: int | None = None


def _hf_download(model: Model, dest: Path, hf_bin: str, revision: str | None,
                 names: list[str] = ()) -> list[str]:
    """`revision` (the commit the probe resolved) overrides the entry's, so the
    files on disk match the checksums recorded for that commit."""
    cmd = [hf_bin, "download", model.hf_repo, *names, "--local-dir", str(model.dest_dir(dest))]
    revision = revision or model.revision
    if revision:
        cmd += ["--revision", revision]
    return cmd


def build_command(model: Model, dest: Path, hf_bin: str, max_workers: int,
                  revision: str | None = None) -> list[str]:
    cmd = _hf_download(model, dest, hf_bin, revision)
    for pat in model.include:
        cmd += ["--include", pat]
    for pat in model.exclude:
        cmd += ["--exclude", pat]
    cmd += ["--max-workers", str(max_workers)]
    return cmd


def build_card_command(model: Model, dest: Path, hf_bin: str, names: list[str],
                       revision: str | None = None) -> list[str]:
    """Fetch named files (model cards the globs excluded) into the same folder."""
    return _hf_download(model, dest, hf_bin, revision, names)


def _run_hf(cmd: list[str]) -> tuple[int, str]:
    """Run `hf download` quietly; return (exit code, its last output lines)."""
    proc = subprocess.run(cmd, capture_output=True, text=True)
    tail = (proc.stderr or proc.stdout or "").strip().splitlines()[-5:]
    return proc.returncode, " | ".join(tail) or f"hf download exited {proc.returncode}"


def download_one(
    st: RepoStatus,
    dest: Path,
    hf_bin: str,
    max_workers: int,
    have_token: bool,
    print_lock: threading.Lock,
) -> DownloadResult:
    m = st.model
    if not st.exists:
        return DownloadResult(m, "failed", message=st.error or "repo unavailable")
    if st.gated and not have_token:
        return DownloadResult(
            m,
            "skipped-gated",
            message="gated repo and no HF token found; run `hf auth login` and accept "
            f"the licence at https://huggingface.co/{m.hf_repo}",
        )

    here, missing = st.local_state(dest)
    if st.files and missing == 0:
        log.info("%s: already complete (%s)", m.id, human(here))
        return DownloadResult(m, "up-to-date", bytes_expected=0, commit=st.commit)

    target = m.dest_dir(dest)
    target.mkdir(parents=True, exist_ok=True)
    cmds = [build_command(m, dest, hf_bin, max_workers, st.commit)]
    if st.extra_cards:
        cmds.append(build_card_command(m, dest, hf_bin, st.extra_cards, st.commit))
    with print_lock:
        log.info("%s -> %s (%s to fetch, %s already there)",
                 m.id, target, human(missing), human(here))
        for cmd in cmds:
            log.debug("exec: %s", " ".join(cmd))

    # `hf download` resumes partial files and skips complete ones by itself.
    for cmd in cmds:
        rc, message = _run_hf(cmd)
        if rc != 0:
            return DownloadResult(m, "failed", bytes_expected=missing, commit=st.commit,
                                  message=message, returncode=rc)
    return DownloadResult(m, "downloaded", bytes_expected=missing, commit=st.commit)


def download_many(
    statuses: list[RepoStatus],
    dest: Path,
    hf_bin: str,
    jobs: int,
    max_workers: int,
    have_token: bool,
) -> list[DownloadResult]:
    lock = threading.Lock()
    results: list[DownloadResult] = []
    if not statuses:
        return results
    with cf.ThreadPoolExecutor(max_workers=max(1, jobs)) as ex:
        futures = {
            ex.submit(download_one, st, dest, hf_bin, max_workers, have_token, lock): st
            for st in statuses
        }
        for fut in cf.as_completed(futures):
            st = futures[fut]
            try:
                res = fut.result()
            except Exception as exc:  # pragma: no cover - defensive
                res = DownloadResult(st.model, "failed", message=f"{type(exc).__name__}: {exc}")
            if res.status == "failed":
                log.error("%s: FAILED — %s", res.model.id, res.message)
            elif res.status == "skipped-gated":
                log.warning("%s: skipped (gated) — %s", res.model.id, res.message)
            else:
                log.info("%s: %s", res.model.id, res.status)
            results.append(res)
    order = {st.model.id: i for i, st in enumerate(statuses)}
    results.sort(key=lambda r: order[r.model.id])
    return results


def human(n: float) -> str:
    """Bytes as a decimal-unit string (drive vendors and the Hub both use GB=1e9)."""
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.2f} {unit}"
        n /= 1000.0
    return f"{n:.2f} TB"


# ================================================================= manifest
def bookkeeping_dir(dest: Path) -> Path:
    """Manifest and logs live in $DEST/_hfarchive/, next to the category folders."""
    return Path(dest) / BOOKKEEPING_DIR


@contextlib.contextmanager
def atomic_target(path: Path):
    """Yield a `.part` path to write; move it onto `path` only on success."""
    part = path.with_name(path.name + ".part")
    try:
        yield part
        os.replace(part, path)
    finally:
        part.unlink(missing_ok=True)


def manifest_write(dest: Path, records: list[dict]) -> Path:
    """Append records, each stamped with time and host. Never rewrites."""
    d = bookkeeping_dir(dest)
    d.mkdir(parents=True, exist_ok=True)
    path = d / MANIFEST_NAME
    stamp = {"timestamp": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "host": platform.node()}
    with path.open("a", encoding="utf-8") as fh:
        for record in records:
            fh.write(json.dumps({**stamp, **record}, ensure_ascii=False) + "\n")
    return path


def checksum_records(st: RepoStatus) -> list[dict]:
    return [{"path": rel, "size": size, **st.hashes.get(rel, {})} for rel, size in st.files]


def manifest_append(dest: Path, results: list[DownloadResult],
                    statuses: dict[str, RepoStatus],
                    extras: dict[str, dict] | None = None) -> Path:
    """One record per model. `extras` adds per-id fields (usage, workflows)."""
    records = []
    for res in results:
        m = res.model
        st = statuses.get(m.id)
        record = {
            "kind": "model",
            "id": m.id,
            "hf_repo": m.hf_repo,
            "revision": m.revision,
            "commit": res.commit,
            "category": m.category,
            "status": res.status,
            "dest": str(m.dest_dir(dest)),
            "rel_dest": os.path.relpath(m.dest_dir(dest), dest),
            "files": st.matched_files if st else None,
            "bytes_matched": st.matched_bytes if st else None,
            "bytes_transferred_estimate": res.bytes_expected,
            "license": m.license,
            "gated": m.gated,
            "runtime": m.usage.runtime if m.usage else None,
            "message": res.message or None,
        }
        if m.benchmarks:
            record["benchmarks"] = [asdict(b) for b in m.benchmarks]
        if st and res.status in GOOD_STATUSES:
            record["checksums"] = checksum_records(st)
        record.update((extras or {}).get(m.id, {}))
        records.append(record)
    return manifest_write(dest, records)


def manifest_read(dest: Path) -> list[dict]:
    path = bookkeeping_dir(dest) / MANIFEST_NAME
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()
            if line.strip()]


def latest_records(records: list[dict], kind: str) -> dict[str, dict]:
    """The newest successful record per id. Records before 1.1 have no `kind`
    and are models."""
    out: dict[str, dict] = {}
    for rec in records:
        if rec.get("kind", "model") == kind and rec.get("status") in GOOD_STATUSES:
            out[rec["id"]] = rec
    return out


# ================================================================ integrity
PROGRESS_MIN_BYTES = 512 * 1024 * 1024


def hash_file(path: Path, algo: str, label: str | None = None) -> str:
    """sha256 of the bytes, or the git blob sha1 (`git hash-object`) when
    algo == "git_sha1". Shows progress on stderr for large files."""
    size = path.stat().st_size
    if algo == "sha256":
        h = hashlib.sha256()
    elif algo == "git_sha1":
        h = hashlib.sha1()
        h.update(f"blob {size}\0".encode())
    else:
        raise ValueError(f"unknown hash: {algo}")
    show = size >= PROGRESS_MIN_BYTES and label is not None
    tty = show and sys.stderr.isatty()
    if show and not tty:
        log.info("hashing %s (%s)...", label, human(size))
    done, last = 0, 0.0
    with path.open("rb") as fh:
        while chunk := fh.read(8 * 1024 * 1024):
            h.update(chunk)
            done += len(chunk)
            if tty and time.monotonic() - last > 0.5:
                last = time.monotonic()
                sys.stderr.write(f"\r  hashing {label}: {done * 100 // size:3d}% "
                                 f"of {human(size)}")
                sys.stderr.flush()
    if tty:
        sys.stderr.write("\r\033[K")
        sys.stderr.flush()
    return h.hexdigest()


def artifact_record(path: Path, dest: Path, **extra) -> dict:
    return {"path": os.path.relpath(path, dest), "size": path.stat().st_size,
            "sha256": hash_file(path, "sha256", path.name), **extra}


@dataclass
class CheckItem:
    label: str
    path: Path
    size: int | None
    algo: str | None = None
    expected: str | None = None


def check_items(dest: Path, records: list[dict]) -> tuple[list[CheckItem], list[str]]:
    """Files the manifest says the drive holds, and ids with nothing to check."""
    items: list[CheckItem] = []
    unverifiable: list[str] = []
    for mid, rec in latest_records(records, "model").items():
        if "checksums" not in rec:
            unverifiable.append(mid)
            continue
        root = Path(dest) / rec["rel_dest"]
        for f in rec["checksums"]:
            algo = "sha256" if "sha256" in f else "git_sha1" if "git_sha1" in f else None
            items.append(CheckItem(f"{mid}: {f['path']}", root / f["path"], f.get("size"),
                                   algo, f.get(algo) if algo else None))
        for wf in rec.get("workflows") or []:
            if wf.get("path"):
                items.append(CheckItem(f"{mid}: {wf['path']}", Path(dest) / wf["path"],
                                       wf.get("size"), "sha256", wf.get("sha256")))
    for rid, rec in latest_records(records, "runtime").items():
        for art in (rec.get("artifacts") or []) + wheel_artifacts(rec.get("wheels")):
            items.append(CheckItem(f"runtime {rid}: {art['path']}", Path(dest) / art["path"],
                                   art.get("size"), "sha256", art.get("sha256")))
    # Every dated config copy stays; config-latest.yaml is overwritten each run,
    # so a path takes the hash of the newest record that wrote it.
    configs: dict[str, CheckItem] = {}
    for rec in records:
        if rec.get("kind") == "config" and rec.get("status") in GOOD_STATUSES:
            for art in rec.get("artifacts") or []:
                configs[art["path"]] = CheckItem(f"config: {art['path']}",
                                                 Path(dest) / art["path"], art.get("size"),
                                                 "sha256", art.get("sha256"))
    items += configs.values()
    for name, rec in latest_records(records, "guide").items():
        items.append(CheckItem(f"guide: {name}", Path(dest) / rec["path"], rec.get("size"),
                               "sha256", rec.get("sha256")))
    return items, unverifiable


def verify_item(item: CheckItem, fast: bool) -> str | None:
    """None if the file is intact, else a one-line problem."""
    try:
        size = item.path.stat().st_size
    except OSError:
        return "missing"
    if item.size is not None and size != item.size:
        return f"wrong size: {size} bytes, expected {item.size}"
    if fast or not item.algo or not item.expected:
        return None
    actual = hash_file(item.path, item.algo, item.label)
    if actual != item.expected:
        return f"wrong {item.algo}: {actual}, expected {item.expected}"
    return None


def cmd_check(dest: Path, fast: bool, as_json: bool) -> int:
    records = manifest_read(dest)
    if not records:
        log.error("no manifest at %s; nothing to check", bookkeeping_dir(dest) / MANIFEST_NAME)
        return 2
    items, unverifiable = check_items(dest, records)
    mode = "sizes only" if fast else "sizes and hashes"
    total = sum(i.size or 0 for i in items)
    log.info("checking %d files (%s, %s) under %s...", len(items), human(total), mode, dest)
    problems = []
    for item in items:
        problem = verify_item(item, fast)
        if problem:
            problems.append({"file": item.label, "path": str(item.path), "problem": problem})
            if not as_json:
                log.error("%s: %s", item.label, problem)
    if as_json:
        print(json.dumps({"checked": len(items), "fast": fast, "problems": problems,
                          "unverifiable": unverifiable}, indent=2))
    for mid in unverifiable:
        log.warning("%s: no checksums recorded (archived before hfarchive 1.1); "
                    "re-run the download to record them", mid)
    if problems:
        log.error("%d of %d files are missing or damaged", len(problems), len(items))
        return 1
    log.info("all %d files intact (%s)", len(items), mode)
    return 0


# =========================================================== guide, config
def guide_name(guide: str) -> str:
    """The file name the guide gets at the drive root."""
    if is_url(guide):
        return urllib.parse.urlsplit(guide).path.rsplit("/", 1)[-1]
    return Path(guide).name


def check_guide(guide: object) -> None:
    if not isinstance(guide, str) or not guide.strip():
        raise CatalogError("guide must be a path or an https URL")
    if "://" in guide and not is_url(guide):
        raise CatalogError(f"guide {guide!r}: only http(s) URLs are supported")
    name = guide_name(guide)
    if not SAFE_NAME.match(name) or name == INDEX_NAME:
        raise CatalogError(f"guide {guide!r} must end in a plain file name other than "
                           f"{INDEX_NAME}")


def guide_sources(cat: Catalog) -> list[Path | str]:
    """Where to look for the guide, in order: a URL as given; else the path
    against the config's directory, the script's directory (a clone), and
    this repo on GitHub. The last two serve configs written by --init."""
    guide = cat.guide
    if not guide:
        return []
    if is_url(guide):
        return [guide]
    path = Path(guide).expanduser()
    if path.is_absolute():
        return [path]
    sources: list[Path | str] = [cat.path.resolve().parent / path]
    if ".." not in path.parts:
        sources += [repo_root() / path, *repo_raw_urls(path.as_posix())]
    return sources


def guide_source(cat: Catalog) -> Path | str | None:
    """The first local file that exists, else the first URL to try. No network."""
    sources = guide_sources(cat)
    for src in sources:
        if isinstance(src, Path) and src.is_file():
            return src
    return next((s for s in sources if isinstance(s, str)), sources[0] if sources else None)


def describe_guide(cat: Catalog) -> str | None:
    """One line for --list and --dry-run: the guide and where it will come from."""
    src = guide_source(cat)
    if src is None:
        return None
    if isinstance(src, Path):
        where = f"from {src}" if src.is_file() else f"not found at {src}"
    else:
        later = [s for s in guide_sources(cat) if isinstance(s, str)][1:]
        where = f"from {src}" + (f", else {later[0]}" if later else "")
    return f"{cat.guide} -> <DEST>/{guide_name(cat.guide)} ({where})"


def copy_file(src: Path, target: Path) -> tuple[int, str]:
    """Copy atomically; return (size, sha256) of the copy."""
    target.parent.mkdir(parents=True, exist_ok=True)
    with atomic_target(target) as part:
        shutil.copyfile(src, part)
    return target.stat().st_size, hash_file(target, "sha256")


def archive_guide(cat: Catalog, dest: Path) -> dict:
    """Copy or download the guide to $DEST/<name>; a manifest record either way."""
    name = guide_name(cat.guide)
    target = Path(dest) / name
    record = {"kind": "guide", "id": name, "guide": cat.guide, "path": name}
    errors = []
    for src in guide_sources(cat):
        try:
            if isinstance(src, Path):
                if not src.is_file():
                    errors.append(f"{src}: not found")
                    continue
                size, sha = copy_file(src, target)
            else:
                size, sha = fetch_url(src, target)
        except (urllib.error.URLError, OSError) as exc:
            errors.append(f"{src}: {exc}")
            continue
        return {**record, "status": "downloaded", "source": str(src), "size": size,
                "sha256": sha}
    return {**record, "status": "failed", "message": "; ".join(errors)}


def archive_config(config: Path, dest: Path) -> dict:
    """Copy the config to _hfarchive/configs/<stem>-<time>.yaml and config-latest.yaml."""
    d = bookkeeping_dir(dest)
    stamped = d / CONFIGS_DIR / f"{config.stem}-{time.strftime('%Y%m%d-%H%M%S')}.yaml"
    artifacts = []
    for target, kind in ((stamped, "copy"), (d / CONFIG_LATEST, "latest")):
        size, sha = copy_file(config, target)
        artifacts.append({"path": os.path.relpath(target, dest), "size": size,
                          "sha256": sha, "kind": kind})
    return {"kind": "config", "id": "config", "status": "downloaded",
            "source": str(config.resolve()), "artifacts": artifacts}


# ================================================================ http
def http_open(url: str, headers: dict | None = None, method: str = "GET",
              timeout: float = 60):
    req = urllib.request.Request(url, method=method,
                                 headers={"User-Agent": USER_AGENT, **(headers or {})})
    return urllib.request.urlopen(req, timeout=timeout)


def fetch_url(url: str, target: Path, expected_size: int | None = None,
              expected_sha256: str | None = None) -> tuple[int, str]:
    """Download to `target` atomically; return (size, sha256). Raises on any
    error or mismatch, leaving any previous `target` untouched."""
    target.parent.mkdir(parents=True, exist_ok=True)
    h = hashlib.sha256()
    size = 0
    with atomic_target(target) as part:
        with http_open(url) as resp, part.open("wb") as out:
            while chunk := resp.read(1024 * 1024):
                out.write(chunk)
                h.update(chunk)
                size += len(chunk)
        digest = h.hexdigest()
        if expected_size is not None and size != expected_size:
            raise OSError(f"got {size} bytes, expected {expected_size}")
        if expected_sha256 and digest != expected_sha256:
            raise OSError(f"sha256 {digest} does not match the published {expected_sha256}")
    return size, digest


def remote_size(url: str) -> int | None:
    try:
        with http_open(url, method="HEAD", timeout=20) as resp:
            length = resp.headers.get("Content-Length")
            return int(length) if length else None
    except (urllib.error.URLError, OSError, ValueError):
        return None


# ================================================================== github
class GitHubError(Exception):
    def __init__(self, message: str, status: int | None = None):
        super().__init__(message)
        self.status = status


@functools.cache
def github_token() -> str | None:
    """GITHUB_TOKEN, else `gh auth token`, else None. Never logged."""
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if not token and shutil.which("gh"):
        try:
            proc = subprocess.run(["gh", "auth", "token"], capture_output=True,
                                  text=True, timeout=15)
            token = proc.stdout.strip() if proc.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            token = None
    return token or None


def github_api(path: str) -> dict:
    headers = {"Accept": "application/vnd.github+json", "X-GitHub-Api-Version": "2022-11-28"}
    token = github_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"
    try:
        with http_open("https://api.github.com" + path, headers) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as exc:
        if exc.code in (403, 429) and exc.headers.get("X-RateLimit-Remaining") == "0":
            hint = ("" if token else " Unauthenticated requests get 60 per hour; set "
                    "GITHUB_TOKEN or run `gh auth login`.")
            raise GitHubError(f"GitHub API rate limit reached.{hint}", exc.code) from exc
        raise GitHubError(f"GitHub API {path}: HTTP {exc.code}", exc.code) from exc
    except (urllib.error.URLError, OSError) as exc:
        raise GitHubError(f"GitHub API {path}: {exc}") from exc


def release_assets(rt: Runtime) -> list[dict]:
    """Assets of the release tagged `rt.ref` whose names match `rt.release_assets`."""
    owner, repo = rt.github_repo  # type: ignore[misc]  # guaranteed by Runtime.parse
    try:
        release = github_api(f"/repos/{owner}/{repo}/releases/tags/{rt.ref}")
    except GitHubError as exc:
        if exc.status == 404:
            raise GitHubError(f"no GitHub release tagged {rt.ref!r} in {owner}/{repo}") from exc
        raise
    out = []
    for asset in release.get("assets") or []:
        if any(fnmatch.fnmatchcase(asset["name"], pat) for pat in rt.release_assets):
            digest = asset.get("digest") or ""
            out.append({
                "name": asset["name"], "size": asset.get("size"),
                "url": asset["browser_download_url"],
                "sha256": digest.split(":", 1)[1] if digest.startswith("sha256:") else None,
            })
    if not out:
        raise GitHubError(f"release {rt.ref!r} has no assets matching {rt.release_assets}")
    return out


# ================================================================ runtimes
class GitError(Exception):
    pass


def git(*args: str) -> str:
    """Run git; return stdout. Raises GitError with git's own message."""
    try:
        proc = subprocess.run(["git", *args], capture_output=True, text=True)
    except FileNotFoundError as exc:
        raise GitError("git is not installed") from exc
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout).strip().splitlines()[-3:]
        raise GitError(f"git {args[0]} failed: " + " | ".join(tail))
    return proc.stdout


_FULL_SHA = re.compile(r"^[0-9a-f]{40}$")


def resolve_remote_ref(url: str, ref: str) -> str | None:
    """Commit sha that `ref` names on the remote, without cloning. None when
    the remote does not advertise it (e.g. an abbreviated sha)."""
    if _FULL_SHA.match(ref):
        return ref
    found: dict[str, str] = {}
    # git lists a tag's peeled commit (`<tag>^{}`) only when asked for it.
    for line in git("ls-remote", url, ref, f"{ref}^{{}}").splitlines():
        sha, name = line.split("\t", 1)
        found[name] = sha
    for name in (f"refs/tags/{ref}^{{}}", f"refs/tags/{ref}", f"refs/heads/{ref}", ref):
        if name in found:
            return found[name]
    return None


@dataclass
class RuntimeStatus:
    runtime: Runtime
    commit: str | None = None
    assets: list[dict] = field(default_factory=list)
    error: str | None = None
    previous: dict | None = None  # manifest record when this commit is already archived
    last: dict | None = None  # newest good manifest record for this id, any commit

    @property
    def archived(self) -> bool:
        return self.previous is not None

    @property
    def asset_bytes(self) -> int:
        return sum(a.get("size") or 0 for a in self.assets)


def already_archived(st: RuntimeStatus, dest: Path | None,
                     records: dict[str, dict]) -> dict | None:
    """The previous record if it holds this commit and every artifact is still
    there. Wheels are checked per platform when they are archived."""
    prev = records.get(st.runtime.id)
    if dest is None or not prev or not st.commit or prev.get("commit") != st.commit:
        return None
    arts = prev.get("artifacts") or []
    for art in arts:
        p = Path(dest) / art["path"]
        if not p.is_file() or p.stat().st_size != art.get("size"):
            return None
    have = {Path(a["path"]).name for a in arts if a.get("kind") == "release-asset"}
    if not {a["name"] for a in st.assets} <= have:
        return None
    return prev


def probe_runtime(rt: Runtime, dest: Path | None, records: dict[str, dict]) -> RuntimeStatus:
    """Resolve the ref and list release assets. Never raises."""
    st = RuntimeStatus(rt, last=records.get(rt.id))
    try:
        st.commit = resolve_remote_ref(rt.git, rt.ref)
        if st.commit is None:
            log.debug("%s: ref %s not advertised by the remote; resolving after fetch",
                      rt.id, rt.ref)
        if rt.release_assets:
            st.assets = release_assets(rt)
    except (GitError, GitHubError) as exc:
        st.error = str(exc)
        return st
    st.previous = already_archived(st, dest, records)
    return st


def probe_runtimes(runtimes: list[Runtime], dest: Path | None) -> list[RuntimeStatus]:
    if not runtimes:
        return []
    records = latest_records(manifest_read(dest), "runtime") if dest and dest.is_dir() else {}
    if any(rt.release_assets for rt in runtimes):
        github_token()  # resolve once, before the threads race to run `gh`
    with cf.ThreadPoolExecutor(max_workers=min(8, len(runtimes))) as ex:
        return list(ex.map(lambda rt: probe_runtime(rt, dest, records), runtimes))


@dataclass
class RuntimeResult:
    runtime: Runtime
    status: str  # downloaded | up-to-date | failed
    commit: str | None = None
    artifacts: list[dict] = field(default_factory=list)
    message: str = ""
    wheels: dict | None = None  # manifest summary of the wheelhouses
    wheels_skipped: bool = False  # --no-wheels: `wheels` is carried over, not attempted

    @property
    def incomplete(self) -> bool:
        """Failed, or archived with some wheels missing this run."""
        return self.status == "failed" or bool(
            self.wheels and not self.wheels_skipped and self.wheels["status"] != "complete")


def update_mirror(rt: Runtime, mirror: Path) -> None:
    """A bare mirror of branches and tags. Plain `git clone --mirror` would also
    fetch GitHub's refs/pull/*, which can double the size for busy repos."""
    if not mirror.is_dir():
        git("init", "--bare", "--quiet", str(mirror))
        git("-C", str(mirror), "remote", "add", "origin", rt.git)
        git("-C", str(mirror), "config", "--replace-all", "remote.origin.fetch",
            "+refs/heads/*:refs/heads/*")
        git("-C", str(mirror), "config", "--add", "remote.origin.fetch",
            "+refs/tags/*:refs/tags/*")
    git("-C", str(mirror), "fetch", "--prune", "--quiet", "origin")


def archive_runtime(st: RuntimeStatus, dest: Path, wheels: bool = True) -> RuntimeResult:
    """Source, release assets and, unless `wheels` is False, the Python wheels,
    under $DEST/_runtimes/<id>/."""
    rt = st.runtime
    if st.error:
        return RuntimeResult(rt, "failed", st.commit, message=st.error)
    if st.previous:
        res = RuntimeResult(rt, "up-to-date", st.commit,
                            artifacts=st.previous.get("artifacts") or [])
    else:
        res = archive_source(st, dest)
        if res.status == "failed":
            return res
    if rt.wheels is None:
        return res
    prev = (st.last or {}).get("wheels")
    if not wheels:
        res.wheels_skipped = True
        # Wheels already on the drive for this config and commit stay recorded.
        if prev and prev.get("fingerprint") == wheels_fingerprint(rt.wheels, res.commit):
            res.wheels = prev
        return res
    res.wheels = archive_wheels(rt, rt.wheels, dest, res.commit, rt.source_tarball(dest), prev)
    if res.wheels["status"] != "complete":
        res.message = f"wheels {res.wheels['status']}: " + "; ".join(
            f"{plat}: {p['message']}" for plat, p in res.wheels["platforms"].items()
            if p.get("message"))
    return res


def archive_source(st: RuntimeStatus, dest: Path) -> RuntimeResult:
    """Mirror, bundle, source tarball and release assets."""
    rt = st.runtime
    d = rt.dest_dir(dest)
    d.mkdir(parents=True, exist_ok=True)
    mirror = d / "mirror.git"
    artifacts: list[dict] = []
    try:
        update_mirror(rt, mirror)
        target = st.commit or rt.ref
        commit = git("-C", str(mirror), "rev-parse", "--verify", f"{target}^{{commit}}").strip()

        bundle = d / f"{rt.id}-{commit}.bundle"
        if not bundle.is_file():
            with atomic_target(bundle) as part:
                git("-C", str(mirror), "bundle", "create", "--quiet", str(part), "--all")
        artifacts.append(artifact_record(bundle, dest, kind="git-bundle"))

        tarball = rt.source_tarball(dest)
        with atomic_target(tarball) as part:
            git("-C", str(mirror), "archive", "--format=tar.gz",
                f"--prefix={rt.source_name()}/", "-o", str(part), commit)
        artifacts.append(artifact_record(tarball, dest, kind="source"))

        for asset in st.assets:
            path = d / f"release-{rt.safe_ref}" / asset["name"]
            log.info("%s: fetching release asset %s (%s)", rt.id, asset["name"],
                     human(asset.get("size") or 0))
            size, sha = fetch_url(asset["url"], path, asset.get("size"), asset.get("sha256"))
            artifacts.append({"path": os.path.relpath(path, dest), "size": size,
                              "sha256": sha, "kind": "release-asset", "url": asset["url"]})
    except (GitError, GitHubError, OSError, urllib.error.URLError) as exc:
        return RuntimeResult(rt, "failed", st.commit, artifacts, message=str(exc))
    return RuntimeResult(rt, "downloaded", commit, artifacts)


def runtime_records(results: list[RuntimeResult], dest: Path) -> list[dict]:
    return [{
        "kind": "runtime", "id": r.runtime.id, "git": r.runtime.git, "ref": r.runtime.ref,
        "commit": r.commit, "status": r.status,
        "rel_dest": os.path.relpath(r.runtime.dest_dir(dest), dest),
        "artifacts": r.artifacts, "tags": r.runtime.tags, "notes": r.runtime.notes,
        "message": r.message or None,
        **({"wheels": r.wheels} if r.wheels else {}),
    } for r in results]


# ================================================================== wheels
LOCK_NAME = "requirements.lock.txt"
WHEELS_INSTALL_NAME = "INSTALL.md"


def wheel_artifacts(summary: dict | None) -> list[dict]:
    """Every file a runtime's wheels summary records: INSTALL.md, wheels, locks."""
    if not summary:
        return []
    arts = [summary["install"]] if summary.get("install") else []
    return arts + [a for p in (summary.get("platforms") or {}).values()
                   for a in p.get("artifacts") or []]


def wheel_stats(platform: dict) -> tuple[int, int]:
    """(number of wheels, their bytes) of one platform's summary."""
    wheels = [a for a in platform.get("artifacts") or [] if a.get("kind") == "wheel"]
    return len(wheels), sum(a["size"] for a in wheels)


def canonical_name(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def wheel_name_version(filename: str) -> tuple[str, str]:
    """(normalised name, version) from a wheel file name."""
    parts = filename[: -len(".whl")].split("-")
    return canonical_name(parts[0]), parts[1].lower()


_PIN_LINE = re.compile(r"^([A-Za-z0-9][A-Za-z0-9._-]*)(?:\[[^\]]*\])?\s*==\s*([^\s;#\\]+)")


def read_pins(path: Path) -> dict[str, str]:
    """name -> version from a resolved requirements file."""
    pins = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        m = _PIN_LINE.match(line.strip())
        if m:
            pins[canonical_name(m[1])] = m[2].lower()
    return pins


def requirement_specs(path: Path, seen: set[Path] | None = None) -> list[str]:
    """Requirement lines of a requirements file, following `-r` includes and
    skipping comments and other options."""
    seen = set() if seen is None else seen
    path = path.resolve()
    if path in seen:
        return []
    seen.add(path)
    specs: list[str] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = re.split(r"(?:^|\s)#", raw, maxsplit=1)[0].strip()
        if not line:
            continue
        m = re.match(r"^(?:-r|--requirement)(?:\s+|=)(\S+)$", line)
        if m:
            specs += requirement_specs(path.parent / m[1], seen)
        elif not line.startswith("-"):
            specs.append(line)
    return specs


def is_pinned(spec: str) -> bool:
    req = spec.split(";", 1)[0]
    return "==" in req or " @ " in req or "://" in req


def index_args(w: Wheels) -> list[str]:
    out = ["--index-url", w.index_url] if w.index_url else []
    for url in w.extra_index_urls:
        out += ["--extra-index-url", url]
    return out


def build_resolve_command(uv: str, w: Wheels, platform_tag: str, inputs: list[Path],
                          output: Path) -> list[str]:
    """`uv pip compile` for the target platform. Unlike `pip download --platform`,
    it evaluates markers such as `sys_platform == "win32"` for the target."""
    return [uv, "pip", "compile", "--no-header", "--no-annotate",
            "--python-version", w.python, "--python-platform", uv_platform(platform_tag),
            "--only-binary", ":all:", "--index-strategy", "unsafe-best-match",
            *index_args(w), "-o", str(output), *map(str, inputs)]


def compatible_platforms(platform_tag: str) -> list[str]:
    """The tags a wheel may carry and still install on `platform_tag`. pip
    download matches --platform exactly, while uv resolves for every older
    manylinux too, so a manylinux_2_28 set can pin a manylinux_2_17 wheel."""
    m = re.fullmatch(r"manylinux_2_(\d+)_(\w+)", platform_tag)
    if not m:
        return [platform_tag]
    minor, arch = int(m.group(1)), m.group(2)
    tags = [f"manylinux_2_{v}_{arch}" for v in range(minor, 4, -1)]
    legacy = {17: "manylinux2014", 12: "manylinux2010", 5: "manylinux1"}
    tags += [f"{name}_{arch}" for v, name in legacy.items() if v <= minor]
    return tags


def build_download_command(pip: list[str], w: Wheels, platform_tag: str, resolved: Path,
                           wheelhouse: Path) -> list[str]:
    """`pip download` of the resolved set, one file per pin."""
    platforms = [a for tag in compatible_platforms(platform_tag) for a in ("--platform", tag)]
    return [*pip, "download", "--no-deps", "--only-binary=:all:", "--implementation", "cp",
            "--python-version", w.python, *platforms,
            "--disable-pip-version-check", "--progress-bar", "off",
            "-d", str(wheelhouse), *index_args(w), "-r", str(resolved)]


def wheel_tools() -> tuple[str | None, list[str] | None, str | None]:
    """(uv, pip command, error). pip comes from this script's environment when
    it has one, else from a throwaway uv environment."""
    uv = shutil.which("uv")
    if not uv:
        return None, None, "uv is not installed; it resolves the wheels for each platform"
    if importlib.util.find_spec("pip"):
        return uv, [sys.executable, "-m", "pip"], None
    return uv, [uv, "run", "--no-project", "--with", "pip", "python", "-m", "pip"], None


def run_tool(cmd: list[str]) -> tuple[int, str]:
    log.debug("running: %s", " ".join(cmd))
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as exc:
        return 127, str(exc)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def tool_error(output: str) -> str:
    # uv decorates its errors with box-drawing characters; keep the words.
    lines = [ln.strip().lstrip("×╰─▶│ ") for ln in output.strip().splitlines()]
    return " | ".join([ln for ln in lines if ln][-3:]) or "failed without output"


def wheels_fingerprint(w: Wheels, commit: str | None) -> str:
    """Changes when the config or the source (and so its requirements) does."""
    blob = json.dumps({"wheels": asdict(w), "commit": commit}, sort_keys=True)
    return hashlib.sha256(blob.encode()).hexdigest()


def wheel_inputs(rt: Runtime, w: Wheels, source: Path,
                 tmp: Path) -> tuple[list[Path], list[str]]:
    """Requirement files from the archived source plus a file of `packages`:
    (files to resolve, the requirement lines they hold)."""
    inputs: list[Path] = []
    specs: list[str] = []
    if w.requirements:
        root = tmp / "src" / rt.source_name()
        wanted = {f"{rt.source_name()}/{req}" for req in w.requirements}
        with tarfile.open(source) as tar:
            # The named files and any requirements files they may include.
            members = [m for m in tar.getmembers() if m.isfile()
                       and (m.name in wanted or m.name.endswith((".txt", ".in")))]
            tar.extractall(tmp / "src", members=members, filter="data")
        for req in w.requirements:
            path = root / req
            if not path.is_file():
                raise FileNotFoundError(f"{req} is not in the source at {rt.ref}")
            inputs.append(path)
            specs += requirement_specs(path)
    if w.packages:
        packages = tmp / "packages.txt"
        packages.write_text("\n".join(w.packages) + "\n", encoding="utf-8")
        inputs.append(packages)
        specs += w.packages
    return inputs, list(dict.fromkeys(specs))


def resolve_wheels(uv: str, w: Wheels, platform_tag: str, inputs: list[Path],
                   specs: list[str], tmp: Path) -> tuple[Path | None, list[dict], str | None]:
    """Resolve the whole set for one platform: (resolved file, unavailable
    lines, error). When the set does not resolve, find the lines that do not
    resolve on their own and resolve the rest without them."""
    resolved = tmp / f"resolved-{platform_tag}.txt"
    rc, out = run_tool(build_resolve_command(uv, w, platform_tag, inputs, resolved))
    if rc == 0:
        return resolved, [], None

    def alone(item: tuple[int, str]) -> dict | None:
        i, spec = item
        one = tmp / f"one-{platform_tag}-{i}.txt"
        one.write_text(spec + "\n", encoding="utf-8")
        rc1, out1 = run_tool(build_resolve_command(uv, w, platform_tag, [one],
                                                   one.with_suffix(".resolved")))
        return None if rc1 == 0 else {"requirement": spec, "error": tool_error(out1)}

    with cf.ThreadPoolExecutor(max_workers=8) as ex:
        unavailable = [u for u in ex.map(alone, enumerate(specs)) if u]
    bad = {u["requirement"] for u in unavailable}
    rest = [s for s in specs if s not in bad]
    if not unavailable or not rest:
        return None, unavailable, tool_error(out)
    rest_file = tmp / f"rest-{platform_tag}.txt"
    rest_file.write_text("\n".join(rest) + "\n", encoding="utf-8")
    rc, out = run_tool(build_resolve_command(uv, w, platform_tag, [rest_file], resolved))
    if rc != 0:
        return None, unavailable, tool_error(out)
    return resolved, unavailable, None


def download_wheelhouse(rt: Runtime, w: Wheels, platform_tag: str, inputs: list[Path],
                        specs: list[str], tools: tuple[str, list[str]], dest: Path, tmp: Path,
                        known: dict[str, dict]) -> dict:
    """Resolve, download and lock one platform; return its manifest summary.
    `known` maps paths to earlier artifact records, whose hashes are reused
    for files of the same size instead of reading them again."""
    uv, pip = tools
    wheelhouse = rt.wheels_dir(dest) / platform_tag
    resolved, unavailable, error = resolve_wheels(uv, w, platform_tag, inputs, specs, tmp)
    if resolved is None:
        return {"status": "failed", "message": f"could not resolve: {error}",
                "unavailable": unavailable}
    pins = read_pins(resolved)
    wheelhouse.mkdir(parents=True, exist_ok=True)
    log.info("%s: downloading %d wheels for %s...", rt.id, len(pins), platform_tag)
    rc, out = run_tool(build_download_command(pip, w, platform_tag, resolved, wheelhouse))
    if rc != 0:  # pip stops at the first pin it cannot fetch; fetch the rest one by one
        have = {wheel_name_version(f.name)[0] for f in wheelhouse.glob("*.whl")}

        def one(item: tuple[str, str]) -> tuple[int, str]:
            name, version = item
            single = tmp / f"pin-{platform_tag}-{name}.txt"
            single.write_text(f"{name}=={version}\n", encoding="utf-8")
            return run_tool(build_download_command(pip, w, platform_tag, single, wheelhouse))

        todo = [(n, v) for n, v in pins.items() if n not in have]
        with cf.ThreadPoolExecutor(max_workers=8) as ex:
            failures = [o for r, o in ex.map(one, todo) if r != 0]
        out = failures[0] if failures else out
        rc = 1 if failures else 0
    files: dict[str, Path] = {}
    for whl in sorted(wheelhouse.glob("*.whl")):
        name, version = wheel_name_version(whl.name)
        if pins.get(name) == version and name not in files:
            files[name] = whl
        else:  # left by an earlier run with other pins
            log.info("%s: removing %s, not in the resolved set", rt.id, whl.name)
            whl.unlink()
    missing = sorted(set(pins) - set(files))
    artifacts, lock_lines = [], []
    for name in sorted(files):
        rel = os.path.relpath(files[name], dest)
        prev = known.get(rel)
        art = (prev if prev and prev.get("size") == files[name].stat().st_size
               else artifact_record(files[name], dest, kind="wheel"))
        artifacts.append(art)
        lock_lines.append(f"{name}=={pins[name]} --hash=sha256:{art['sha256']}")
    lock = wheelhouse / LOCK_NAME
    header = [f"# {rt.id} {rt.ref}: wheels for Python {w.python} on {platform_tag}.",
              "# Written by hfarchive from the files in this folder; install with",
              "#   python -m pip install --no-index --find-links <this folder> -r <this file>"]
    header += [f"# not available as a wheel: {u['requirement']}" for u in unavailable]
    header += [f"# resolved but not downloaded: {name}=={pins[name]}" for name in missing]
    with atomic_target(lock) as part:
        part.write_text("\n".join(header + lock_lines) + "\n", encoding="utf-8")
    artifacts.append(artifact_record(lock, dest, kind="wheel-lock"))

    problems = []
    if unavailable:
        problems.append("not available as wheels: "
                        + ", ".join(u["requirement"] for u in unavailable))
    if missing:
        problems.append("not downloaded: " + ", ".join(missing)
                        + (f" ({tool_error(out)})" if rc != 0 else ""))
    elif rc != 0:
        problems.append(f"pip download failed: {tool_error(out)}")
    summary = {"status": "complete" if not problems else "partial" if files else "failed",
               "unavailable": unavailable, "missing": missing, "artifacts": artifacts}
    if problems:
        summary["message"] = "; ".join(problems)
    return summary


def reusable_wheelhouse(dest: Path, platform_tag: str, prev: dict,
                        fingerprint: str) -> dict | None:
    """The previous summary of a complete wheelhouse whose config and source
    are unchanged and whose wheels (by size) and lock (by hash) are intact."""
    p = (prev.get("platforms") or {}).get(platform_tag)
    if prev.get("fingerprint") != fingerprint or not p or p.get("status") != "complete":
        return None
    for a in p.get("artifacts") or []:
        item = CheckItem(a["path"], Path(dest) / a["path"], a.get("size"), "sha256",
                         a.get("sha256"))
        if verify_item(item, fast=a.get("kind") == "wheel"):
            return None
    return p


def archive_wheels(rt: Runtime, w: Wheels, dest: Path, commit: str | None, source: Path,
                   prev: dict | None) -> dict:
    """Wheelhouses for every platform and their INSTALL.md; return the manifest
    summary. Never raises; a platform that fails is recorded as failed."""
    fingerprint = wheels_fingerprint(w, commit)
    prev = prev or {}
    platforms: dict[str, dict] = {}
    for plat in w.platforms:
        reused = reusable_wheelhouse(dest, plat, prev, fingerprint)
        if reused is not None:
            log.info("%s: wheels for %s already archived", rt.id, plat)
            platforms[plat] = reused
    todo = [plat for plat in w.platforms if plat not in platforms]
    unpinned = prev.get("unpinned") or []
    if todo:
        uv, pip, error = wheel_tools()
        with tempfile.TemporaryDirectory(prefix="hfarchive-wheels-") as tmp:
            inputs: list[Path] = []
            if error is None:
                try:
                    inputs, specs = wheel_inputs(rt, w, source, Path(tmp))
                    unpinned = [s for s in specs if not is_pinned(s)]
                except (OSError, tarfile.TarError, UnicodeDecodeError) as exc:
                    error = str(exc)
            for plat in todo:
                if error is not None:
                    platforms[plat] = {"status": "failed", "message": error}
                    continue
                known = {a["path"]: a for a in ((prev.get("platforms") or {}).get(plat) or {})
                         .get("artifacts") or [] if a.get("kind") == "wheel"}
                p = platforms[plat] = download_wheelhouse(
                    rt, w, plat, inputs, specs, (uv, pip), Path(dest), Path(tmp), known)
                n, size = wheel_stats(p)
                log.log(logging.INFO if p["status"] == "complete" else logging.ERROR,
                        "%s: wheels for %s %s (%d wheels, %s)%s", rt.id, plat, p["status"],
                        n, human(size), f" — {p['message']}" if p.get("message") else "")
    statuses = {p["status"] for p in platforms.values()}
    summary = {
        "python": w.python, "fingerprint": fingerprint,
        "status": ("complete" if statuses == {"complete"}
                   else "failed" if statuses == {"failed"} else "partial"),
        "unpinned": unpinned,
        "platforms": {plat: platforms[plat] for plat in w.platforms},
    }
    install = rt.wheels_dir(dest) / WHEELS_INSTALL_NAME
    install.parent.mkdir(parents=True, exist_ok=True)
    with atomic_target(install) as part:
        part.write_text(install_markdown(rt, w, commit, summary), encoding="utf-8")
    summary["install"] = artifact_record(install, dest, kind="wheel-install")
    return summary


def install_commands(rt: Runtime, python: str, platform_tag: str) -> list[str]:
    """Offline install of one wheelhouse, run from _runtimes/<id>/."""
    win = platform_tag.startswith("win")

    def path(*parts: str) -> str:
        return ("\\" if win else "/").join(parts)

    src, wd = rt.source_name(), rt.wheels_dir(Path()).name
    venv_python = path(src, ".venv", "Scripts" if win else "bin", "python")
    return ["```bat" if win else "```sh",
            f"cd {path(RUNTIMES_DIR, rt.id)}",
            f"tar -xzf {rt.source_tarball(Path()).name}",
            f"{'py -' if win else 'python'}{python} -m venv {path(src, '.venv')}",
            f"{venv_python} -m pip install --no-index --find-links {path(wd, platform_tag)} "
            f"-r {path(wd, platform_tag, LOCK_NAME)}",
            "```"]


def install_markdown(rt: Runtime, w: Wheels, commit: str | None, summary: dict) -> str:
    src = rt.source_name()
    lines = [
        f"# {rt.id} {rt.ref}: offline install", "",
        f"Python {w.python} dependencies of {rt.id} at `{rt.ref}` (commit "
        f"`{commit or 'not recorded'}`), saved by hfarchive {__version__}. Each platform "
        f"folder holds the wheels and `{LOCK_NAME}`, the exact set with sha256 hashes, "
        "which pip checks on install. No network is needed.", "",
    ]
    if w.requirements:
        lines.append("Resolved from " + ", ".join(f"`{r}`" for r in w.requirements)
                     + " in the source" + (" plus:" if w.packages else "."))
    if w.packages:
        if not w.requirements:
            lines.append("Resolved from:")
        lines += ["", *[f"- `{p}`" for p in w.packages]]
    indexes = ([w.index_url] if w.index_url else []) + w.extra_index_urls
    if indexes:
        lines += ["", "Indexes: " + ", ".join(f"<{u}>" for u in indexes)]
    lines += [
        "",
        f"The commands run from `_runtimes/{rt.id}/` on this drive (or a copy of it). They "
        f"unpack the source to `{src}/` and create `{src}/.venv` with Python {w.python}, "
        "which the wheels are built for. To install into an environment you already have "
        "(for a custom node pack, the one ComfyUI runs in), skip the venv step and run "
        "that environment's python instead.", "",
    ]
    for plat, p in summary["platforms"].items():
        lines += [f"## {plat}", ""]
        n, size = wheel_stats(p)
        if not n:
            lines += [f"Not archived: {p.get('message') or 'failed'}.", ""]
            continue
        lines += [f"{p['status'].capitalize()}: {n} wheels, {human(size)}.", "",
                  *install_commands(rt, w.python, plat), ""]
        gaps = [u["requirement"] for u in p.get("unavailable") or []] + (p.get("missing") or [])
        if gaps:
            lines += ["Not in this wheelhouse; install these online or from another source:",
                      "", *[f"- `{g}`" for g in gaps], ""]
    if summary["unpinned"]:
        lines += ["## Unpinned requirements", "",
                  "These lines name no exact version. The lock files pin what they resolved "
                  "to when this archive was made:", "",
                  *[f"- `{u}`" for u in summary["unpinned"]], ""]
    lines += ["## Start", "",
              w.start.rstrip() if w.start else f"Follow the README in `{src}/`.", ""]
    return "\n".join(lines)


# =================================================================== usage
BENCHMARK_CAVEAT = ("Published scores are for the full-precision model; "
                    "the archived quant scores lower.")
HEADLINE_BENCHMARKS = 3


def usage_markdown(entries: list[Model], model_dir: Path, dest: Path, cat: Catalog,
                   commits: dict[str, str | None]) -> str:
    """USAGE.md for one folder; several entries may share a repo folder."""
    repo = entries[0].hf_repo
    lines = [f"# {repo}", "",
             f"Hub page: https://huggingface.co/{repo}", "",
             "Written by hfarchive from the archive config. The Hub page may be gone "
             "by the time you read this; everything below was archived on this drive.", ""]
    for m in entries:
        u = m.usage or Usage()
        lines += [f"## {m.id}", ""]
        lines.append(f"- Revision: `{m.revision or 'main'}`, commit "
                     f"`{commits.get(m.id) or 'not recorded'}`")
        if m.include:
            lines.append("- Files: " + ", ".join(f"`{p}`" for p in m.include))
        if u.runtime:
            rt = cat.runtime_by_id(u.runtime)
            where = (f", archived under `{os.path.relpath(rt.dest_dir(dest), model_dir)}/` "
                     f"(ref `{rt.ref}`)" if rt else "")
            lines.append(f"- Runtime: {u.runtime}{where}")
        if m.license:
            lines.append(f"- License: {m.license}")
        lines.append("")
        if u.notes:
            lines += ["### Recommended settings", "", u.notes.rstrip(), ""]
        if u.workflows:
            lines += ["### Workflows", ""]
            lines += [f"- `{WORKFLOWS_DIR}/{wf.name}` (from <{wf.url}>)" for wf in u.workflows]
            lines.append("")
        if m.benchmarks:
            lines += ["### Benchmarks", "", BENCHMARK_CAVEAT, "",
                      "| Benchmark | Score | Source | Date | Note |", "|---|---:|---|---|---|"]
            lines += [f"| {_cell(b.name)} | {_cell(b.score)} | <{b.source}> | "
                      f"{_cell(b.date or '-')} | {_cell(b.note or '-')} |" for b in m.benchmarks]
            lines.append("")
        if m.notes:
            lines += ["### Notes", "", m.notes.rstrip(), ""]
    return "\n".join(lines)


def has_usage_md(m: Model) -> bool:
    return bool(m.usage or m.benchmarks)


def write_usage_files(models: list[Model], dest: Path, cat: Catalog,
                      commits: dict[str, str | None]) -> dict[str, dict]:
    """Fetch workflows and write USAGE.md for each model with `usage` or
    `benchmarks`.

    Returns per-id manifest fields; a workflow that fails carries an `error`.
    """
    extras: dict[str, dict] = {}
    for m in models:
        if not has_usage_md(m):
            continue
        model_dir = m.dest_dir(dest)
        model_dir.mkdir(parents=True, exist_ok=True)
        workflows = []
        for wf in (m.usage.workflows if m.usage else []):
            path = model_dir / WORKFLOWS_DIR / wf.name
            entry = {"name": wf.name, "url": wf.url, "path": os.path.relpath(path, dest)}
            try:
                entry["size"], entry["sha256"] = fetch_url(wf.url, path)
            except (urllib.error.URLError, OSError) as exc:
                entry["error"] = str(exc)
                log.error("%s: workflow %s FAILED — %s", m.id, wf.name, exc)
            workflows.append(entry)
        sharing = [x for x in cat.models if has_usage_md(x) and x.dest_dir(dest) == model_dir]
        usage = model_dir / USAGE_NAME
        usage.write_text(usage_markdown(sharing or [m], model_dir, dest, cat, commits),
                         encoding="utf-8")
        extras[m.id] = {"usage": os.path.relpath(usage, dest), "workflows": workflows}
    return extras


# =================================================================== index
def _cell(text: object) -> str:
    return str(text).replace("|", "\\|").replace("\n", " ")


def _link(text: str, path: str) -> str:
    return f"[{_cell(text)}](<{path}>)"


def index_links(records: list[dict]) -> list[str]:
    """Links to the archived guide(s) and the config of the latest run."""
    lines = [f"- Selection guide: {_link(name, rec['path'])}"
             for name, rec in latest_records(records, "guide").items()]
    if latest_records(records, "config"):
        configs = f"{BOOKKEEPING_DIR}/{CONFIGS_DIR}/"
        lines.append(f"- Config of the latest run: "
                     f"{_link(CONFIG_LATEST, f'{BOOKKEEPING_DIR}/{CONFIG_LATEST}')}; "
                     f"every run's config is in {_link(configs, configs)}")
    return lines + [""] if lines else []


def headline_benchmarks(rec: dict) -> str:
    return "; ".join(_cell(f"{b['name']} {b['score']}")
                     for b in (rec.get("benchmarks") or [])[:HEADLINE_BENCHMARKS]) or "-"


def index_markdown(records: list[dict]) -> str:
    models = latest_records(records, "model")
    runtimes = latest_records(records, "runtime")
    total = sum(r.get("bytes_matched") or 0 for r in models.values())
    out = [
        "# Model archive", "",
        f"Regenerated by hfarchive {__version__} on {time.strftime('%Y-%m-%d %H:%M %Z')} "
        f"from `{BOOKKEEPING_DIR}/{MANIFEST_NAME}`.", "",
        *index_links(records),
        "Each model folder is a plain snapshot of a Hugging Face repo at the commit shown, "
        "laid out as `<category>/<org>/<repo>/`. Point llama.cpp, ComfyUI or "
        "`from_pretrained()` at it. `USAGE.md` holds the recommended settings and "
        f"benchmarks, `{WORKFLOWS_DIR}/` the workflow files. Benchmarks are published "
        "scores for the full-precision model; the archived quants score lower.", "",
        "Integrity: the manifest records every file's size and hash (sha256 for LFS "
        "files, git blob sha1 for the rest). `hfarchive --check --dest <this drive>` "
        "recomputes them; without hfarchive, `sha256sum <file>` or "
        "`git hash-object <file>` give the same values.", "",
        "Runtimes are in `_runtimes/<id>/`: restore the source with "
        "`git clone <id>-<sha>.bundle <dir> && git -C <dir> checkout <sha>`, or unpack "
        "the `-src.tar.gz`. Prebuilt binaries, if any, are in `release-<ref>/`; Python "
        "dependencies, if any, in `wheels-<ref>/`, whose `INSTALL.md` gives the offline "
        "install commands.", "",
        f"## Models ({len(models)}, {human(total)})", "",
    ]
    by_cat: dict[str, list[dict]] = {}
    for rec in models.values():
        by_cat.setdefault(rec.get("category") or "?", []).append(rec)
    for category in sorted(by_cat):
        out += [f"### {category}", "",
                "| Model | Repo | Revision / commit | Size | Runtime | Benchmarks | Usage "
                "| Workflows |",
                "|---|---|---|---:|---|---|---|---|"]
        for rec in sorted(by_cat[category], key=lambda r: r["id"]):
            wfs = ", ".join(_link(w["name"], w["path"]) for w in rec.get("workflows") or []
                            if w.get("path") and not w.get("error")) or "-"
            usage = _link(USAGE_NAME, rec["usage"]) if rec.get("usage") else "-"
            out.append(" | ".join([
                f"| {_cell(rec['id'])}",
                _link(rec["hf_repo"], rec["rel_dest"] + "/"),
                f"`{_cell(rec.get('revision') or 'main')}` @ `{rec.get('commit') or '?'}`",
                human(rec.get("bytes_matched") or 0),
                _cell(rec.get("runtime") or "-"),
                headline_benchmarks(rec),
                usage, wfs,
            ]) + " |")
        out.append("")
    out += [f"## Runtimes ({len(runtimes)})", ""]
    if runtimes:
        out += ["| Runtime | Source | Ref | Commit | Files | Offline install |",
                "|---|---|---|---|---|---|"]
        for rid in sorted(runtimes):
            rec = runtimes[rid]
            files = ", ".join(_link(Path(a["path"]).name, a["path"])
                              for a in rec.get("artifacts") or [])
            wheels = rec.get("wheels") or {}
            install = "-"
            if wheels.get("install"):
                plats = ", ".join(f"{plat} {p['status']}"
                                  for plat, p in (wheels.get("platforms") or {}).items())
                install = (f"{_link(WHEELS_INSTALL_NAME, wheels['install']['path'])} "
                           f"(Python {_cell(wheels.get('python'))}: {_cell(plats)})")
            out.append(f"| {_cell(rid)} | <{rec.get('git')}> | `{_cell(rec.get('ref'))}` | "
                       f"`{rec.get('commit') or '?'}` | {files or '-'} | {install} |")
    else:
        out.append("None archived.")
    out.append("")
    return "\n".join(out)


def write_index(dest: Path) -> Path:
    path = Path(dest) / INDEX_NAME
    with atomic_target(path) as part:
        part.write_text(index_markdown(manifest_read(dest)), encoding="utf-8")
    return path


# ====================================================================== cli
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hfarchive",
        description="Archive a YAML-defined set of Hugging Face models onto a drive.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  hfarchive --init                 # curated selection -> ./models.yaml\n"
            "  hfarchive --init --minimal       # small commented starter instead\n"
            "  hfarchive --list\n"
            "  hfarchive --verify-only --config examples/tweet-2026-09.yaml\n"
            "  hfarchive --dry-run --dest /mnt/backup\n"
            "  hfarchive --dest /mnt/backup --profile embeddings\n"
            "  hfarchive --dest /mnt/backup --allow-large\n"
            "  hfarchive --check --dest /mnt/backup [--fast]\n"
        ),
    )
    p.add_argument("--version", action="version", version=f"hfarchive {__version__}")
    p.add_argument("--config", default=None,
                   help=f"path to the YAML config (default: ./{DEFAULT_CONFIG}; in a clone "
                        f"without it, examples/{CURATED_CONFIG})")
    p.add_argument("--profile", default=None,
                   help="profile to resolve (default: the config's default_profile, "
                        "else every enabled entry)")
    p.add_argument("--dest", default=os.environ.get(DEST_ENV),
                   help=f"destination root, e.g. /mnt/backup (env: {DEST_ENV})")

    mode = p.add_argument_group("modes")
    mode.add_argument("--init", action="store_true",
                      help=f"write the curated selection ({CURATED_CONFIG}) to --config "
                           "and exit")
    mode.add_argument("--minimal", action="store_true",
                      help="with --init: write a small commented starter instead")
    mode.add_argument("--list", action="store_true", help="print the resolved selection, no network")
    mode.add_argument("--verify-only", action="store_true",
                      help="check every repo exists on the Hub, download nothing")
    mode.add_argument("--dry-run", action="store_true",
                      help="resolve sizes and target paths, write nothing")
    mode.add_argument("--refresh-sizes", action="store_true",
                      help="write measured approx_bytes back into the config")
    mode.add_argument("--check", action="store_true",
                      help="verify the archive at --dest against its manifest; no network")
    mode.add_argument("--fast", action="store_true",
                      help="with --check: compare sizes only, skip hashing")

    sel = p.add_argument_group("selection")
    sel.add_argument("--only", action="append", default=[], help="comma-separated model ids to use instead of the profile; repeatable")
    sel.add_argument("--exclude", action="append", default=[], help="comma-separated model ids to drop; repeatable")
    sel.add_argument("--enable", action="append", default=[], help="comma-separated ids to force in even if disabled; repeatable")
    sel.add_argument("--category", action="append", default=[], help="comma-separated categories to keep; repeatable")
    sel.add_argument("--no-runtimes", action="store_true",
                     help="skip the runtimes the selection would include")
    sel.add_argument("--no-wheels", action="store_true",
                     help="archive runtimes without their Python wheels")

    beh = p.add_argument_group("download behaviour")
    beh.add_argument("--jobs", type=int, default=None, help="repos downloaded in parallel")
    beh.add_argument("--max-workers", type=int, default=None, help="files in parallel per repo")
    beh.add_argument("--allow-large", "--i-know", dest="allow_large", action="store_true",
                     help="permit entries at or above the large-repo threshold")
    beh.add_argument("--large-repo-gb", type=float, default=None,
                     help="large-repo threshold in GB (default from config)")
    beh.add_argument("--min-free-gb", type=float, default=None,
                     help="required free headroom on the destination")
    beh.add_argument("--ignore-space", action="store_true",
                     help="proceed even if the plan does not fit in the free space")
    beh.add_argument("--allow-home-dest", action="store_true",
                     help="allow a destination inside $HOME or on its filesystem "
                          "(normally refused)")

    out = p.add_argument_group("output")
    out.add_argument("--json", action="store_true", help="machine-readable output")
    out.add_argument("--verbose", "-v", action="store_true", help="debug logging")
    return p


def csv_list(values: list[str] | str) -> list[str]:
    """Flatten repeated and comma-separated flag values: --only a,b --only c -> [a, b, c]."""
    if isinstance(values, str):
        values = [values]
    return [v.strip() for value in values for v in value.split(",") if v.strip()]


def log_dir() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "hfarchive" / "logs"


def setup_logging(verbose: bool) -> Path:
    directory = log_dir()
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"hfarchive-{time.strftime('%Y%m%d-%H%M%S')}.log"
    log.setLevel(logging.DEBUG)
    for handler in log.handlers:
        handler.close()
    log.handlers.clear()

    fh = logging.FileHandler(path, encoding="utf-8")
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(logging.Formatter("%(asctime)s %(levelname)-7s %(message)s"))
    log.addHandler(fh)

    ch = logging.StreamHandler(sys.stderr)
    ch.setLevel(logging.DEBUG if verbose else logging.INFO)
    ch.setFormatter(logging.Formatter("%(message)s"))
    log.addHandler(ch)
    return path


def render_table(headers: list[str], rows: list[list[str]], aligns: str = "") -> str:
    if not rows:
        return "(nothing selected)"
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    aligns = (aligns + "l" * len(headers))[: len(headers)]

    def fmt(cells: list[str]) -> str:
        parts = []
        for cell, w, a in zip(cells, widths, aligns):
            parts.append(cell.rjust(w) if a == "r" else cell.ljust(w))
        return "  ".join(parts).rstrip()

    sep = "  ".join("-" * w for w in widths)
    return "\n".join([fmt(headers), sep] + [fmt(r) for r in rows])


def flag_str(m: Model) -> str:
    bits = []
    if m.gated:
        bits.append("gated")
    if not m.enabled:
        bits.append("off")
    if m.include or m.exclude:
        bits.append("globs")
    return ",".join(bits) or "-"


def runtime_users(rt: Runtime, models: list[Model]) -> list[str]:
    return [m.id for m in models if m.usage and m.usage.runtime == rt.id]


def workflow_rows(models: list[Model]) -> list[tuple[Model, Workflow]]:
    return [(m, wf) for m in models if m.usage for wf in m.usage.workflows]


def wheels_cell(rt: Runtime, wheels: bool) -> str:
    if rt.wheels is None:
        return "-"
    return rt.wheels.describe() if wheels else "skipped (--no-wheels)"


def render_extras(models: list[Model], runtimes: list[Runtime],
                  rt_status: dict[str, RuntimeStatus] | None = None,
                  wf_sizes: dict[tuple[str, str], int | None] | None = None,
                  wheels: bool = True) -> str:
    """Runtime and workflow tables shared by --list (offline) and --dry-run."""
    parts = []
    if runtimes:
        rows = []
        for rt in runtimes:
            users = runtime_users(rt, models)
            used_by = ", ".join(users) if len(users) <= 2 else f"{len(users)} models"
            if rt_status is None:
                rows.append([rt.id, rt.ref, ", ".join(rt.release_assets) or "-", used_by,
                             wheels_cell(rt, wheels), rt.git])
                continue
            st = rt_status[rt.id]
            state = "ERROR: " + st.error if st.error else "archived" if st.archived else "to fetch"
            assets = f"{len(st.assets)}, {human(st.asset_bytes)}" if st.assets else "-"
            rows.append([rt.id, rt.ref, (st.commit or "?")[:12], assets, used_by,
                         wheels_cell(rt, wheels), rt.git, state])
        headers = (["ID", "REF", "COMMIT", "ASSETS", "USED BY", "WHEELS", "GIT", "STATUS"]
                   if rt_status is not None
                   else ["ID", "REF", "RELEASE ASSETS", "USED BY", "WHEELS", "GIT"])
        parts.append(f"runtimes ({len(runtimes)}):\n" + render_table(headers, rows))
    wfs = workflow_rows(models)
    if wfs:
        rows = []
        for m, wf in wfs:
            size = (wf_sizes or {}).get((m.id, wf.name))
            rows.append([m.id, wf.name, human(size) if size is not None else "?", wf.url])
        parts.append(f"workflows ({len(wfs)}):\n"
                     + render_table(["MODEL", "NAME", "SIZE", "URL"], rows, "llrl"))
    known = {rt.id for rt in runtimes}
    dangling = sorted({m.usage.runtime for m in models
                       if m.usage and m.usage.runtime and m.usage.runtime not in known})
    if dangling:
        parts.append("runtimes named in usage but not archived by this selection: "
                     + ", ".join(dangling))
    return "\n\n".join(parts)


def runtime_json(rt: Runtime) -> dict:
    return asdict(rt)


def usage_json(m: Model) -> dict | None:
    return asdict(m.usage) if m.usage else None


def guide_json(cat: Catalog) -> dict | None:
    if not cat.guide:
        return None
    src = guide_source(cat)
    return {"guide": cat.guide, "name": guide_name(cat.guide),
            "source": str(src) if src is not None else None}


def cmd_list(cat: Catalog, models: list[Model], runtimes: list[Runtime], args) -> int:
    prof = cat.profile(args.profile)
    if args.json:
        print(json.dumps(
            {
                "profile": prof.name,
                "description": prof.description.strip(),
                "count": len(models),
                "models": [
                    {
                        "id": m.id, "hf_repo": m.hf_repo, "category": m.category,
                        "tags": m.tags, "license": m.license, "gated": m.gated,
                        "approx_bytes": m.approx_bytes, "enabled": m.enabled,
                        "include": m.include, "exclude": m.exclude, "notes": m.notes,
                        "usage": usage_json(m),
                        "benchmarks": [asdict(b) for b in m.benchmarks],
                    }
                    for m in models
                ],
                "runtimes": [runtime_json(rt) for rt in runtimes],
                "guide": guide_json(cat),
            },
            indent=2,
        ))
        return 0

    print(f"profile: {prof.name} — {prof.description.strip() or '(no description)'}")
    print(f"config: {cat.path}\n")
    rows = [
        [m.id, m.hf_repo, m.category,
         human(m.approx_bytes) if m.approx_bytes else "?",
         m.license or "?", str(len(m.benchmarks)) if m.benchmarks else "-", flag_str(m)]
        for m in models
    ]
    print(render_table(
        ["ID", "HF REPO", "CATEGORY", "APPROX", "LICENSE", "BENCH", "FLAGS"], rows, "lllrlrl"))
    known = sum(m.approx_bytes for m in models)
    unknown = sum(1 for m in models if not m.approx_bytes)
    print(f"\n{len(models)} models, approx {human(known)}"
          + (f" (+{unknown} unmeasured; run --refresh-sizes)" if unknown else ""))
    guide = describe_guide(cat)
    if guide:
        print(f"guide: {guide}")
    extras = render_extras(models, runtimes, wheels=not args.no_wheels)
    if extras:
        print("\n" + extras)
    return 0


def cmd_verify(models: list[Model], args) -> int:
    log.info("checking %d repos against the Hub...", len(models))
    statuses = probe_all(models)
    ok = [s for s in statuses if s.exists and not s.error]
    gated_ok = [s for s in statuses if s.exists and s.gated]
    bad = [s for s in statuses if not s.exists or s.error]

    if args.json:
        print(json.dumps([
            {
                "id": s.model.id, "hf_repo": s.model.hf_repo, "exists": s.exists,
                "gated": s.gated, "commit": s.commit, "files": s.matched_files,
                "bytes": s.matched_bytes, "repo_bytes": s.total_repo_bytes,
                "error": s.error,
            } for s in statuses
        ], indent=2))
    else:
        rows = []
        for s in statuses:
            if not s.exists:
                verdict = "MISSING"
            elif s.error:
                verdict = "WARN"
            elif s.gated:
                verdict = "OK (gated)"
            else:
                verdict = "OK"
            rows.append([
                s.model.id, s.model.hf_repo, verdict,
                (s.commit or "")[:8],
                str(s.matched_files) if s.exists else "-",
                human(s.matched_bytes) if s.matched_files else "-",
                s.error or "",
            ])
        print(render_table(
            ["ID", "HF REPO", "STATUS", "COMMIT", "FILES", "MATCHED", "NOTE"],
            rows, "llllrrl"))
        print(f"\n{len(ok)} ok, {len(gated_ok)} gated, {len(bad)} problematic "
              f"({len(statuses)} checked)")
    return 1 if any(not s.exists for s in statuses) else 0


def on_home_filesystem(path: Path) -> bool:
    """True if `path` is inside $HOME or on the same filesystem as it."""
    home = Path.home()
    resolved = path.resolve()
    if resolved == home or home in resolved.parents:
        return True
    try:
        return os.stat(resolved).st_dev == os.stat(home).st_dev
    except OSError:
        return False


def resolve_dest(args) -> tuple[Path | None, list[str], bool]:
    """Return (dest, problems, fatal).

    `fatal` separates "the drive is not plugged in yet", which degrades to a
    dry run because planning ahead is useful, from "this destination is wrong",
    which must fail loudly rather than quietly downloading nothing.
    """
    if not args.dest:
        return None, [f"no destination given (--dest or ${DEST_ENV})"], False
    dest = Path(args.dest).expanduser()
    if not dest.exists():
        return dest, [f"destination does not exist: {dest}"], False

    problems: list[str] = []
    if not dest.is_dir():
        return dest, [f"destination is not a directory: {dest}"], True
    if not args.allow_home_dest and on_home_filesystem(dest):
        problems.append(
            f"destination {dest.resolve()} is on the same filesystem as {Path.home()}; "
            "hfarchive is meant for a separate drive. Use --allow-home-dest to override."
        )
    if not os.access(dest, os.W_OK):
        problems.append(f"destination is not writable: {dest}")
    return dest, problems, bool(problems)


def plan_rows(statuses: list[RepoStatus], dest: Path | None) -> list[dict]:
    rows = []
    for s in statuses:
        here = missing = 0
        if dest is not None and s.files:
            here, missing = s.local_state(dest)
        elif s.files:
            missing = s.matched_bytes
        rows.append({"status": s, "model": s.model, "present": here, "missing": missing})
    return rows


def probe_workflow_sizes(models: list[Model]) -> dict[tuple[str, str], int | None]:
    wfs = workflow_rows(models)
    if not wfs:
        return {}
    with cf.ThreadPoolExecutor(max_workers=min(8, len(wfs))) as ex:
        sizes = list(ex.map(lambda pair: remote_size(pair[1].url), wfs))
    return {(m.id, wf.name): size for (m, wf), size in zip(wfs, sizes, strict=True)}


def cmd_plan(cat: Catalog, models: list[Model], runtimes: list[Runtime], args,
             dest: Path | None, dest_problems: list[str], forced_dry: bool,
             fatal_dest: bool) -> tuple[int, bool]:
    """Shared path for --dry-run and the real download.

    Returns (exit code, whether any download was actually attempted). Nothing is
    written to the destination unless that second value is True.
    """
    defaults = cat.defaults
    large_gb = args.large_repo_gb if args.large_repo_gb is not None else defaults["large_repo_gb"]
    min_free_gb = args.min_free_gb if args.min_free_gb is not None else defaults["min_free_gb"]
    large_bytes = large_gb * 1e9

    log.info("resolving %d repos against the Hub...", len(models))
    statuses = probe_all(models)
    rows = plan_rows(statuses, dest)
    if runtimes:
        log.info("resolving %d runtime(s)...", len(runtimes))
    rt_statuses = probe_runtimes(runtimes, dest)
    rt_by_id = {st.runtime.id: st for st in rt_statuses}
    dry = args.dry_run or forced_dry
    wf_sizes = probe_workflow_sizes(models) if dry else {}

    have_token = token_available()

    table = []
    for r in rows:
        s: RepoStatus = r["status"]
        m: Model = r["model"]
        if not s.exists:
            note = s.error or "unavailable"
        elif s.gated and not have_token:
            note = "gated: will skip (no token)"
        elif s.gated:
            note = "gated: token present"
        elif s.matched_bytes >= large_bytes and not args.allow_large:
            note = "large: needs --allow-large"
        elif r["missing"] == 0 and s.files:
            note = "already complete"
        else:
            note = s.error or ""
        table.append([
            m.id, m.hf_repo,
            str(s.matched_files) if s.exists else "-",
            human(s.matched_bytes) if s.exists else "-",
            human(r["missing"]) if s.exists else "-",
            "yes" if m.gated else "no",
            str(len(m.benchmarks)) if m.benchmarks else "-",
            str(m.dest_dir(dest)) if dest else f"<DEST>/{m.category}/{m.org}/{m.name}",
            note,
        ])

    if args.json:
        print(json.dumps([
            {
                "kind": "model",
                "id": r["model"].id, "hf_repo": r["model"].hf_repo,
                "exists": r["status"].exists, "gated": r["model"].gated,
                "files": r["status"].matched_files,
                "bytes_matched": r["status"].matched_bytes,
                "bytes_missing": r["missing"], "bytes_present": r["present"],
                "commit": r["status"].commit,
                "dest": str(r["model"].dest_dir(dest)) if dest else None,
                "benchmarks": len(r["model"].benchmarks),
                "workflows": [
                    {"name": w.name, "url": w.url, "size": wf_sizes.get((r["model"].id, w.name))}
                    for w in (r["model"].usage.workflows if r["model"].usage else [])
                ],
            } for r in rows
        ] + [
            {
                "kind": "runtime", **runtime_json(st.runtime), "commit": st.commit,
                "assets": [{"name": a["name"], "size": a["size"]} for a in st.assets],
                "archived": st.archived, "error": st.error,
            } for st in rt_statuses
        ] + ([{"kind": "guide", **guide_json(cat)}] if cat.guide else []), indent=2))
    else:
        print(render_table(
            ["ID", "HF REPO", "FILES", "MATCHED", "TO FETCH", "GATED", "BENCH", "DEST", "NOTE"],
            table, "lllrrlrll"))
        extras = render_extras(models, runtimes, rt_by_id, wf_sizes, wheels=not args.no_wheels)
        if extras:
            print("\n" + extras)

    total_matched = sum(s.matched_bytes for s in statuses)
    total_missing = sum(r["missing"] for r in rows)
    # Release assets are the only runtime bytes known ahead; git history is not.
    rt_missing = sum(st.asset_bytes for st in rt_statuses if not st.archived)
    oversized = [r for r in rows
                 if r["status"].matched_bytes >= large_bytes and r["missing"] > 0]
    gated_skips = [r for r in rows if r["status"].gated and not have_token]
    broken = [r for r in rows if not r["status"].exists]

    print(flush=True)  # stdout is buffered; keep the table ahead of the log lines when both are redirected
    log.info("catalogued %s across %d repos; %s still to fetch",
             human(total_matched), len(rows), human(total_missing))
    if gated_skips:
        log.warning("%d gated repo(s) will be skipped (no HF token): %s",
                    len(gated_skips), ", ".join(r["model"].id for r in gated_skips))
        log.warning("  -> run `hf auth login` and accept each licence on the model page")
    if broken:
        log.error("%d repo(s) could not be resolved: %s",
                  len(broken), ", ".join(r["model"].id for r in broken))
    if rt_statuses:
        log.info("%d runtime(s), %d already archived; %s of release assets to fetch "
                 "plus git history", len(rt_statuses),
                 sum(1 for st in rt_statuses if st.archived), human(rt_missing))
    with_wheels = [st.runtime for st in rt_statuses if st.runtime.wheels]
    if with_wheels and not args.no_wheels:
        log.info("%d runtime(s) with Python wheels (%s); their size is known only once "
                 "downloaded (a CUDA PyTorch set is several GB per platform)",
                 len(with_wheels), ", ".join(rt.id for rt in with_wheels))
    for st in rt_statuses:
        if st.error:
            log.error("runtime %s: %s", st.runtime.id, st.error)
    if cat.guide:
        log.info("guide: %s", describe_guide(cat))
    if oversized:
        log.warning("%d repo(s) are >= %s each: %s",
                    len(oversized), human(large_bytes),
                    ", ".join(r["model"].id for r in oversized))

    if dry:
        if forced_dry and not args.dry_run:
            level = log.error if fatal_dest else log.warning
            level("cannot download: %s", "; ".join(dest_problems))
        log.info("dry run: nothing was written")
        return (2 if fatal_dest else 0), False

    # ---- from here on we are actually going to write to the drive ----
    if dest_problems:
        for problem in dest_problems:
            log.error("%s", problem)
        return 2, False

    assert dest is not None
    free = shutil.disk_usage(dest).free
    log.info("destination %s: %s free", dest, human(free))
    if free < min_free_gb * 1e9:
        log.error("only %s free, below the %s headroom required (--min-free-gb)",
                  human(free), human(min_free_gb * 1e9))
        return 2, False

    to_run = [r for r in rows if r["status"].exists]
    if oversized and not args.allow_large:
        blocked = ", ".join(r["model"].id for r in oversized)
        log.error("refusing to download %d repo(s) of %s or more without --allow-large: %s",
                  len(oversized), human(large_bytes), blocked)
        log.error("re-run with --allow-large (alias --i-know), or narrow with --only/--exclude")
        return 3, False

    budget = free - min_free_gb * 1e9
    if total_missing + rt_missing > budget and not args.ignore_space:
        log.error("plan needs %s but only %s is usable (%s free minus %s headroom)",
                  human(total_missing + rt_missing), human(budget), human(free),
                  human(min_free_gb * 1e9))
        log.error("narrow the selection, use a bigger drive, or pass --ignore-space")
        return 2, False

    jobs = args.jobs if args.jobs is not None else defaults["jobs"]
    max_workers = (args.max_workers if args.max_workers is not None
                   else defaults["max_workers_per_repo"])
    hf_bin = resolve_hf_bin()
    if not hf_bin:
        log.error("could not find the `hf` CLI; install huggingface_hub or set $%s", HF_BIN_ENV)
        return 2, False
    log.info("using %s with %d parallel repo(s), %d file worker(s) each",
             hf_bin, jobs, max_workers)

    # Runtimes first: they are small, and a long model run may be interrupted.
    for st in rt_statuses:
        if not st.archived and not st.error:
            log.info("runtime %s: archiving %s at %s", st.runtime.id, st.runtime.git,
                     st.runtime.ref)
    with cf.ThreadPoolExecutor(max_workers=max(1, min(4, len(rt_statuses)))) as ex:
        rt_results = list(ex.map(lambda st: archive_runtime(st, dest, not args.no_wheels),
                                 rt_statuses))
    for res in rt_results:
        if res.status == "failed":
            log.error("runtime %s: FAILED — %s", res.runtime.id, res.message)
        elif res.incomplete:
            log.error("runtime %s: %s, PARTIAL (%s) — %s", res.runtime.id, res.status,
                      res.commit, res.message)
        else:
            log.info("runtime %s: %s (%s)", res.runtime.id, res.status, res.commit)
    if rt_results:
        manifest_write(dest, runtime_records(rt_results, dest))

    # The config and guide are small and explain the archive, so they go
    # before the long model downloads too.
    meta = [archive_config(cat.path, dest)]
    if cat.guide:
        meta.append(archive_guide(cat, dest))
    manifest_write(dest, meta)
    guide_failed = [r for r in meta if r["status"] == "failed"]
    for rec in meta:
        if rec["status"] == "failed":
            log.error("guide %s: FAILED — %s", rec["guide"], rec["message"])
        else:
            log.info("%s archived: %s", rec["kind"], rec.get("path") or
                     ", ".join(a["path"] for a in rec["artifacts"]))

    results = download_many(
        [r["status"] for r in to_run], dest, hf_bin, jobs, max_workers, have_token)

    commits = {mid: rec.get("commit")
               for mid, rec in latest_records(manifest_read(dest), "model").items()}
    commits.update({r.model.id: r.commit for r in results})
    good = [r.model for r in results if r.status in GOOD_STATUSES]
    extras = write_usage_files(good, dest, cat, commits)
    wf_failed = [(mid, wf) for mid, ex in extras.items() for wf in ex["workflows"]
                 if wf.get("error")]

    mpath = manifest_append(dest, results, {s.model.id: s for s in statuses}, extras)
    log.info("manifest updated: %s", mpath)
    log.info("index written: %s", write_index(dest))

    done = sum(1 for r in results if r.status == "downloaded")
    fresh = sum(1 for r in results if r.status == "up-to-date")
    skipped = sum(1 for r in results if r.status == "skipped-gated")
    failed = [r for r in results if r.status == "failed"]
    rt_failed = [r for r in rt_results if r.incomplete]
    log.info("done: %d downloaded, %d already current, %d gated-skipped, %d failed",
             done, fresh, skipped, len(failed))
    if rt_results or wf_failed:
        log.info("runtimes: %d archived or current, %d failed or partial; workflows: %d failed",
                 len(rt_results) - len(rt_failed), len(rt_failed), len(wf_failed))
    for r in failed:
        log.error("  %s: %s", r.model.id, r.message)
    for r in rt_failed:
        log.error("  runtime %s: %s", r.runtime.id, r.message)
    for mid, wf in wf_failed:
        log.error("  %s: workflow %s: %s", mid, wf["name"], wf["error"])
    for rec in guide_failed:
        log.error("  guide %s: %s", rec["guide"], rec["message"])
    return (1 if failed or rt_failed or wf_failed or guide_failed else 0), True


def cmd_refresh_sizes(cat: Catalog, models: list[Model], args) -> int:
    log.info("measuring %d repos...", len(models))
    statuses = probe_all(models)
    sizes = {s.model.id: s.matched_bytes for s in statuses if s.exists and s.files}
    failed = [s for s in statuses if not s.exists or not s.files]
    updated = write_approx_bytes(cat.path, sizes)
    log.info("measured %d repos, updated %d approx_bytes entries in %s",
             len(sizes), updated, cat.path)
    for s in failed:
        log.warning("  %s: %s", s.model.id, s.error or "no files matched")
    return 1 if failed else 0


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.minimal and not args.init:
        parser.error("--minimal only applies to --init")
    if args.fast and not args.check:
        parser.error("--fast only applies to --check")
    if args.init:
        return write_starter_config(Path(args.config or DEFAULT_CONFIG).expanduser(),
                                    minimal=args.minimal)

    log_path = setup_logging(args.verbose)
    log.debug("argv: %s", argv if argv is not None else sys.argv[1:])

    if args.check:
        # Needs only the drive: no config, no network.
        if not args.dest or not Path(args.dest).expanduser().is_dir():
            log.error("--check needs an existing --dest (or $%s)", DEST_ENV)
            return 2
        return cmd_check(Path(args.dest).expanduser(), args.fast, args.json)

    config_path, notice = resolve_config(args.config)
    if notice:
        log.info("%s", notice)
    try:
        cat = load_catalog(config_path)
        only = csv_list(args.only)
        models = cat.select(
            profile=args.profile,
            only=only,
            exclude=csv_list(args.exclude),
            enable=csv_list(args.enable),
            categories=csv_list(args.category),
        )
        # --only/--category narrow to named models, so profile tags stop applying.
        runtimes = [] if args.no_runtimes else cat.select_runtimes(
            models, args.profile, by_tags=not (only or args.category))
    except CatalogError as exc:
        log.error("%s", exc)
        return 2

    if not models:
        log.error("the selection is empty (profile %r)", cat.profile(args.profile).name)
        return 2

    if args.list:
        return cmd_list(cat, models, runtimes, args)
    if args.refresh_sizes:
        return cmd_refresh_sizes(cat, models, args)
    if args.verify_only:
        return cmd_verify(models, args)

    dest, dest_problems, fatal_dest = resolve_dest(args)
    # An absent destination degrades to a dry run rather than failing: planning
    # is useful before the drive is plugged in. A *wrong* one is an error.
    forced_dry = bool(dest_problems)

    rc, downloaded = cmd_plan(
        cat, models, runtimes, args, dest, dest_problems, forced_dry, fatal_dest)

    # Only touch the drive when downloads actually ran: a refused run (too
    # large, no room, bad destination) must leave it exactly as it was.
    if downloaded and dest is not None and dest.is_dir():
        try:
            logs_on_dest = bookkeeping_dir(dest) / "logs"
            logs_on_dest.mkdir(parents=True, exist_ok=True)
            shutil.copy2(log_path, logs_on_dest / log_path.name)
        except OSError as exc:
            log.warning("could not copy the log to the drive: %s", exc)
    log.info("log: %s", log_path)
    return rc


if __name__ == "__main__":
    raise SystemExit(main())
