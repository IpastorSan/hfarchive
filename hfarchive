# =================================================================== config
class CatalogError(Exception):
    """Raised when the YAML config is malformed or a selection is impossible."""


# Runtime ids and workflow names become file names on the drive.
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]*$")


def _check_keys(what: str, body: dict, allowed: set[str], required: set[str]) -> None:
    if not isinstance(body, dict):
        raise CatalogError(f"{what} must be a mapping")
    unknown = set(body) - allowed
    if unknown:
        raise CatalogError(f"{what} has unknown keys: {sorted(unknown)}")
    missing = required - set(body)
    if missing:
        raise CatalogError(f"{what} is missing {sorted(missing)}")


@dataclass
class Workflow:
    """A file fetched by URL into <model dir>/_workflows/<name>."""
    name: str
    url: str


@dataclass
class Usage:
    runtime: str | None = None
    notes: str | None = None
    workflows: list[Workflow] = field(default_factory=list)

    @classmethod
    def parse(cls, model_id: str, body: dict) -> Usage:
        _check_keys(f"model {model_id!r} usage", body, {"runtime", "notes", "workflows"}, set())
        workflows: list[Workflow] = []
        for wf in body.get("workflows") or []:
            _check_keys(f"model {model_id!r} workflow", wf, {"name", "url"}, {"name", "url"})
            if not SAFE_NAME.match(str(wf["name"])):
                raise CatalogError(f"model {model_id!r}: workflow name {wf['name']!r} must be "
                                   "a plain file name")
            workflows.append(Workflow(name=str(wf["name"]), url=str(wf["url"])))
        names = [w.name for w in workflows]
        if len(names) != len(set(names)):
            raise CatalogError(f"model {model_id!r}: duplicate workflow names")
        runtime = body.get("runtime")
        return cls(runtime=str(runtime) if runtime is not None else None,
                   notes=body.get("notes"), workflows=workflows)


BENCHMARK_SCORE_MAX_CHARS = 40


@dataclass
class Benchmark:
    """A published score for the full-precision model, with its source."""
    name: str
    score: float | int | str
    source: str
    date: str | None = None
    note: str | None = None

    @classmethod
    def parse(cls, model_id: str, body: dict) -> Benchmark:
        what = f"model {model_id!r} benchmark"
        _check_keys(what, body, set(cls.__dataclass_fields__), {"name", "score", "source"})
        name, score, source = body["name"], body["score"], body["source"]
        if not isinstance(name, str) or not name.strip():
            raise CatalogError(f"{what}: name must be a non-empty string")
        numeric = isinstance(score, (int, float)) and not isinstance(score, bool)
        if not numeric and not (isinstance(score, str) and score.strip()
                                and len(score) <= BENCHMARK_SCORE_MAX_CHARS):
            raise CatalogError(f"{what} {name!r}: score must be a number or a short string")
        if not is_url(source):
            raise CatalogError(f"{what} {name!r}: source must be an http(s) URL")
        date = body.get("date")
        if date is not None and not isinstance(date, (str, datetime.date)):
            raise CatalogError(f"{what} {name!r}: date must be a date such as 2026-11-13")
        note = body.get("note")
        if note is not None and not isinstance(note, str):
            raise CatalogError(f"{what} {name!r}: note must be a string")
        # YAML reads 2026-11-13 as a date; keep it as text for Markdown and JSON.
        return cls(name=name, score=score, source=source,
                   date=str(date) if date is not None else None, note=note)

    @property
    def headline(self) -> str:
        return f"{self.name} {self.score}"


def is_url(value: object) -> bool:
    return isinstance(value, str) and value.startswith(("https://", "http://"))


_GITHUB_REPO = re.compile(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$")

# pip's --platform tags mapped to uv's --python-platform, which resolves
# environment markers for the target instead of for this machine.
_UV_PLATFORMS = [
    (re.compile(r"manylinux_(\d+)_(\d+)_(x86_64|aarch64)"),
     lambda m: f"{m[3]}-manylinux_{m[1]}_{m[2]}"),
    (re.compile(r"manylinux2014_(x86_64|aarch64)"), lambda m: f"{m[1]}-manylinux2014"),
    (re.compile(r"win_amd64"), lambda m: "x86_64-pc-windows-msvc"),
    (re.compile(r"win_arm64"), lambda m: "aarch64-pc-windows-msvc"),
    (re.compile(r"macosx_\d+_\d+_arm64"), lambda m: "aarch64-apple-darwin"),
    (re.compile(r"macosx_\d+_\d+_x86_64"), lambda m: "x86_64-apple-darwin"),
]


def uv_platform(tag: str) -> str | None:
    for pattern, convert in _UV_PLATFORMS:
        m = pattern.fullmatch(tag)
        if m:
            return convert(m)
    return None


def _str_list(what: str, value: object, check=None) -> None:
    if not isinstance(value, list) or not all(isinstance(v, str) and v.strip() for v in value):
        raise CatalogError(f"{what} must be a list of non-empty strings")
    for v in value:
        problem = check(v) if check else None
        if problem:
            raise CatalogError(f"{what}: {v!r} {problem}")


@dataclass
class Wheels:
    """Python dependencies of a runtime, saved as one wheelhouse per platform."""
    python: str
    platforms: list[str]
    requirements: list[str] = field(default_factory=list)
    packages: list[str] = field(default_factory=list)
    index_url: str | None = None
    extra_index_urls: list[str] = field(default_factory=list)
    start: str | None = None

    @classmethod
    def parse(cls, runtime_id: str, body: dict) -> Wheels:
        what = f"runtime {runtime_id!r} wheels"
        _check_keys(what, body, set(cls.__dataclass_fields__), {"python", "platforms"})
        w = cls(**body)
        # YAML reads an unquoted 3.10 as the float 3.1.
        if not isinstance(w.python, str) or not re.fullmatch(r"3\.\d+", w.python):
            raise CatalogError(f"{what}: python must be a quoted version such as \"3.12\"")
        _str_list(f"{what} platforms", w.platforms, lambda p: None if uv_platform(p) else (
            "is not supported; use manylinux_2_28_x86_64, manylinux2014_x86_64, "
            "win_amd64, win_arm64 or macosx_11_0_arm64 style tags"))
        if not w.platforms or len(set(w.platforms)) != len(w.platforms):
            raise CatalogError(f"{what}: platforms must be a non-empty list without duplicates")
        _str_list(f"{what} requirements", w.requirements, lambda p: (
            "must be a relative path inside the source"
            if p.startswith(("/", "\\")) or ".." in Path(p).parts else None))
        _str_list(f"{what} packages", w.packages)
        if not w.requirements and not w.packages:
            raise CatalogError(f"{what}: needs `requirements` or `packages`")
        if w.index_url is not None and not is_url(w.index_url):
            raise CatalogError(f"{what}: index_url must be an http(s) URL")
        _str_list(f"{what} extra_index_urls", w.extra_index_urls,
                  lambda u: None if is_url(u) else "is not an http(s) URL")
        if w.start is not None and not isinstance(w.start, str):
            raise CatalogError(f"{what}: start must be a string")
        return w

    def describe(self) -> str:
        """One line for --list and --dry-run."""
        def count(items: list, noun: str) -> str:
            return f"{len(items)} {noun}{'s' if len(items) != 1 else ''}"

        parts = [f"py{self.python}: " + ", ".join(self.platforms)]
        if self.requirements:
            parts.append(count(self.requirements, "requirement file"))
        if self.packages:
            parts.append(count(self.packages, "package"))
        return "; ".join(parts)


@dataclass
class Runtime:
    """A program needed to run models, archived as git history plus builds."""
    id: str
    git: str
    ref: str = "HEAD"
    release_assets: list[str] = field(default_factory=list)
    tags: list[str] = field(default_factory=list)
    enabled: bool = True
    notes: str | None = None
    wheels: Wheels | None = None

    @classmethod
    def parse(cls, body: dict) -> Runtime:
        what = f"runtime {body.get('id')!r}" if isinstance(body, dict) else "runtime"
        _check_keys(what, body, set(cls.__dataclass_fields__), {"id", "git"})
        rt = cls(**body)
        rt.id, rt.ref = str(rt.id), str(rt.ref)
        if not SAFE_NAME.match(rt.id):
            raise CatalogError(f"runtime id {rt.id!r} must be a plain file name")
        if rt.wheels is not None:
            rt.wheels = Wheels.parse(rt.id, rt.wheels)
        if rt.release_assets and not rt.github_repo:
            raise CatalogError(f"runtime {rt.id!r}: release_assets needs a github.com git URL")
        if rt.release_assets and rt.ref == "HEAD":
            raise CatalogError(f"runtime {rt.id!r}: release_assets needs `ref` to name a tag")
        return rt

    @property
    def github_repo(self) -> tuple[str, str] | None:
        m = _GITHUB_REPO.search(self.git)
        return (m.group(1), m.group(2)) if m else None

    @property
    def safe_ref(self) -> str:
        return re.sub(r"[^A-Za-z0-9._+-]", "_", self.ref)

    def dest_dir(self, dest: Path) -> Path:
        return Path(dest) / RUNTIMES_DIR / self.id

    def wheels_dir(self, dest: Path) -> Path:
        return self.dest_dir(dest) / f"wheels-{self.safe_ref}"

    def source_name(self) -> str:
        """The folder the source tarball unpacks to."""
        return f"{self.id}-{self.safe_ref}"

    def source_tarball(self, dest: Path) -> Path:
        return self.dest_dir(dest) / f"{self.source_name()}-src.tar.gz"


@dataclass
class Model:
    id: str
    hf_repo: str
    category: str
    revision: str | None = None
    include: list[str] = field(default_factory=list)
    exclude: list[str] = field(default_factory=list)
    tags: list[str] = field(default_factory=list)
    license: str | None = None
    gated: bool = False
    approx_bytes: int = 0
    enabled: bool = True
    notes: str | None = None
    usage: Usage | None = None
    benchmarks: list[Benchmark] = field(default_factory=list)

    @property
    def org(self) -> str:
        return self.hf_repo.split("/", 1)[0]

    @property
    def name(self) -> str:
        return self.hf_repo.split("/", 1)[1]

    def dest_dir(self, dest: Path) -> Path:
        """Layout on the drive: $DEST/<category>/<repo_org>/<repo_name>/."""
        return Path(dest) / self.category / self.org / self.name


@dataclass
class Profile:
    name: str
    description: str = ""
    any_tags: list[str] = field(default_factory=list)
    all_tags: list[str] = field(default_factory=list)
    ids: list[str] = field(default_factory=list)
    all: bool = False
    include_disabled: bool = False

    def matches(self, m: Model | Runtime) -> bool:
        """Models and runtimes share `id` and `tags`, so one rule set serves both."""
        if self.all:
            return True
        if m.id in self.ids:
            return True
        tags = set(m.tags)
        if self.all_tags and tags.issuperset(self.all_tags):
            return True
        if self.any_tags and tags & set(self.any_tags):
            return True
        return False


# Used when neither --profile nor `default_profile` names one.
ALL_ENABLED = Profile(name="(all enabled)", description="every enabled entry", all=True)


@dataclass
class Catalog:
    path: Path
    defaults: dict
    profiles: dict[str, Profile]
    models: list[Model]
    default_profile: str | None = None
    runtimes: list[Runtime] = field(default_factory=list)
    guide: str | None = None

    def by_id(self, model_id: str) -> Model:
        for m in self.models:
            if m.id == model_id:
                return m
        raise CatalogError(f"unknown model id: {model_id}")

    def profile(self, name: str | None) -> Profile:
        """Resolve a profile name; None means `default_profile`, else all enabled."""
        name = name or self.default_profile
        if name is None:
            return ALL_ENABLED
        if name not in self.profiles:
            available = ", ".join(sorted(self.profiles)) or "(none defined)"
            raise CatalogError(f"unknown profile {name!r}; available: {available}")
        return self.profiles[name]

    def select(
        self,
        profile: str | None = None,
        only: list[str] | None = None,
        exclude: list[str] | None = None,
        enable: list[str] | None = None,
        categories: list[str] | None = None,
    ) -> list[Model]:
        prof = self.profile(profile)
        forced = set(enable or [])
        for fid in forced:
            self.by_id(fid)  # validate early

        picked: list[Model] = []
        for m in self.models:
            if m.id in forced:
                picked.append(m)
                continue
            if not prof.matches(m):
                continue
            if not m.enabled and not prof.include_disabled:
                continue
            picked.append(m)

        if only:
            wanted = set(only)
            for oid in wanted:
                self.by_id(oid)
            # --only may name models the profile did not select; honour it.
            picked = [m for m in self.models if m.id in wanted]
        if exclude:
            for eid in exclude:
                self.by_id(eid)
            picked = [m for m in picked if m.id not in set(exclude)]
        if categories:
            picked = [m for m in picked if m.category in set(categories)]
        return picked

    def select_runtimes(self, models: list[Model], profile: str | None = None,
                        by_tags: bool = True) -> list[Runtime]:
        """Runtimes named by the selected models' `usage.runtime`, plus, when
        `by_tags`, those the profile's rules match. `enabled: false` keeps a
        runtime out unless the profile has `include_disabled`."""
        prof = self.profile(profile)
        named = {m.usage.runtime for m in models if m.usage and m.usage.runtime}
        return [
            rt for rt in self.runtimes
            if (rt.enabled or prof.include_disabled)
            and (rt.id in named or (by_tags and prof.matches(rt)))
        ]

    def runtime_by_id(self, runtime_id: str | None) -> Runtime | None:
        return next((rt for rt in self.runtimes if rt.id == runtime_id), None)


def load_catalog(path: str | Path) -> Catalog:
    path = Path(path)
    if not path.is_file():
        raise CatalogError(f"config not found: {path} (create one with --init)")
    try:
        raw = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as exc:
        raise CatalogError(f"{path} is not valid YAML: {exc}") from exc
    if not isinstance(raw, dict):
        raise CatalogError(f"{path} must be a YAML mapping")

    defaults = dict(DEFAULTS)
    defaults.update(raw.get("defaults") or {})

    profiles: dict[str, Profile] = {}
    for name, body in (raw.get("profiles") or {}).items():
        body = body or {}
        unknown = set(body) - {
            "description", "any_tags", "all_tags", "ids", "all", "include_disabled",
        }
        if unknown:
            raise CatalogError(f"profile {name!r} has unknown keys: {sorted(unknown)}")
        profiles[name] = Profile(name=name, **body)

    default_profile = raw.get("default_profile")
    if default_profile is not None and default_profile not in profiles:
        raise CatalogError(f"default_profile {default_profile!r} is not a defined profile")

    models: list[Model] = []
    seen: set[str] = set()
    known = set(Model.__dataclass_fields__)
    for entry in raw.get("models") or []:
        unknown = set(entry) - known
        if unknown:
            raise CatalogError(f"model {entry.get('id')!r} has unknown keys: {sorted(unknown)}")
        missing = {"id", "hf_repo", "category"} - set(entry)
        if missing:
            raise CatalogError(f"model {entry.get('id')!r} is missing {sorted(missing)}")
        m = Model(**entry)
        if m.usage is not None:
            m.usage = Usage.parse(m.id, m.usage)
        if not isinstance(m.benchmarks, list):
            raise CatalogError(f"model {m.id!r}: benchmarks must be a list")
        m.benchmarks = [Benchmark.parse(m.id, b) for b in m.benchmarks]
        if m.id in seen:
            raise CatalogError(f"duplicate model id: {m.id}")
        if "/" not in m.hf_repo:
            raise CatalogError(f"{m.id}: hf_repo must be 'org/name', got {m.hf_repo!r}")
        seen.add(m.id)
        models.append(m)
    if not models:
        raise CatalogError("config defines no models")

    runtimes = [Runtime.parse(body) for body in raw.get("runtimes") or []]
    rt_ids = [rt.id for rt in runtimes]
    if len(rt_ids) != len(set(rt_ids)):
        raise CatalogError("duplicate runtime ids")

    guide = raw.get("guide")
    if guide is not None:
        check_guide(guide)

    return Catalog(path=path, defaults=defaults, profiles=profiles, models=models,
                   default_profile=default_profile, runtimes=runtimes, guide=guide)


_ID_LINE = re.compile(r"^\s*-\s+id:\s*(\S+)\s*$")
_SIZE_LINE = re.compile(r"^(\s*)approx_bytes:\s*\d+\s*$")


def write_approx_bytes(path: str | Path, sizes: dict[str, int]) -> int:
    """Rewrite `approx_bytes:` in place, preserving comments and formatting.

    Returns the number of entries updated.
    """
    path = Path(path)
    lines = path.read_text().splitlines(keepends=True)
    current: str | None = None
    updated = 0
    for i, line in enumerate(lines):
        m = _ID_LINE.match(line)
        if m:
            current = m.group(1)
            continue
        s = _SIZE_LINE.match(line)
        if s and current in sizes:
            new = f"{s.group(1)}approx_bytes: {sizes[current]}\n"
            if new != line:
                updated += 1
            lines[i] = new
    path.write_text("".join(lines))
    return updated


